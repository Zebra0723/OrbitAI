#!/bin/bash
# The whole test suite. Run it with:
#
#   tests/run              everything
#   tests/run intents      just the files whose names match
#
# No dependencies beyond bash. Nothing here touches your real state, needs
# a network, or needs a Mac.

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE/.." || exit 1

# shellcheck disable=SC1091
. "$HERE/helpers.sh"

files=()
if [ $# -gt 0 ]; then
  for want in "$@"; do
    for f in "$HERE"/*.test.sh; do
      case "$(basename "$f")" in *"$want"*) files+=("$f") ;; esac
    done
  done
  # The Python suites are picked by the same names, further down.
  pyfiles=0
  for want in "$@"; do
    for f in "$HERE"/*.py; do
      case "$(basename "$f" .py)" in *"$want"*) pyfiles=1 ;; esac
    done
  done
  if [ ${#files[@]} -eq 0 ] && [ "$pyfiles" -eq 0 ]; then
    echo "No test file matches: $*" >&2
    echo "Have: $(cd "$HERE" && ls *.test.sh *.py 2>/dev/null \
                  | sed 's/\.test\.sh$//; s/\.py$//' | sort -u | tr '\n' ' ')" >&2
    exit 2
  fi
else
  for f in "$HERE"/*.test.sh; do files+=("$f"); done
fi
# `files` can legitimately be empty when only a Python suite was asked for,
# and "${files[@]}" on an empty array is an unbound variable under set -u.
files+=()

started="$(date +%s)"
report() {
  # $1 name, $2 failures, $3 total
  if [ "$2" -eq 0 ]; then
    printf '  ok    %-14s %d\n' "$1" "$3"
  else
    printf '  FAIL  %-14s %d of %d\n' "$1" "$2" "$3"
  fi
}

for f in ${files[@]+"${files[@]}"}; do
  _run_name="$(basename "$f" .test.sh)"
  _run_before_pass=$PASS
  _run_before_fail=$FAIL
  CURRENT_FILE="$_run_name"
  # Each file runs in this shell so it can add to the tallies, but gets a
  # state directory of its own. Underscored names here because a sourced
  # file shares this scope and will happily reuse a plain one.
  # shellcheck disable=SC1090
  . "$f"
  test_sandbox_clean
  report "$_run_name" "$(( FAIL - _run_before_fail ))" \
         "$(( (PASS - _run_before_pass) + (FAIL - _run_before_fail) ))"
done

# The Python and Node suites run on their own and report a tally at the end.
for f in "$HERE"/*.py "$HERE"/*.mjs; do
  [ -f "$f" ] || continue
  _run_name="$(basename "$(basename "$f" .py)" .mjs)"
  [ $# -gt 0 ] && ! printf '%s\n' "$@" | grep -qF "$_run_name" && continue
  case "$f" in
    *.mjs)
      if command -v node >/dev/null 2>&1; then
        _run_out="$(cd "$HERE/.." && node "$f" 2>&1)"
      else
        printf '  skip  %-14s node is not installed\n' "$_run_name"
        continue
      fi ;;
    *) _run_out="$(cd "$HERE/.." && python3 "$f" 2>&1)" ;;
  esac
  _run_tally="$(printf '%s' "$_run_out" | grep '^TALLY ' | tail -1)"
  _run_pass="$(printf '%s' "$_run_tally" | cut -d' ' -f2)"
  _run_fail="$(printf '%s' "$_run_tally" | cut -d' ' -f3)"
  if [ -z "$_run_tally" ]; then
    echo "  $_run_name reported nothing:"
    printf '%s\n' "$_run_out" | sed 's/^/    /'
    FAIL=$((FAIL + 1))
    report "$_run_name" 1 1
    continue
  fi
  PASS=$((PASS + _run_pass))
  FAIL=$((FAIL + _run_fail))
  [ "$_run_fail" -gt 0 ] && FAILURES+=("$(printf '%s' "$_run_out" | grep -v '^TALLY ')")
  if [ "$((_run_pass + _run_fail))" -eq 0 ]; then
    printf '  skip  %-14s %s\n' "$_run_name" \
      "$(printf '%s' "$_run_out" | grep -m1 'skipped' | sed 's/.*skipped - //')"
  else
    report "$_run_name" "$_run_fail" "$((_run_pass + _run_fail))"
  fi
done

echo
if [ "$FAIL" -gt 0 ]; then
  for f in "${FAILURES[@]}"; do
    echo "$f"
    echo
  done
fi
printf '%d passed, %d failed, %ds\n' "$PASS" "$FAIL" "$(( $(date +%s) - started ))"
[ "$FAIL" -eq 0 ]
