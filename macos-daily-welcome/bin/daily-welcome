#!/bin/bash
# daily-welcome - greets you once a day, the first time you open the Mac.
#
# Normally invoked by the background agent (see install.sh); run it by hand
# with --force to hear it, or --status to see what it thinks.

set -uo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

# shellcheck source=../lib/config.sh
. "$ROOT/lib/config.sh"
welcome_load_user_config
# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"
# shellcheck source=../lib/sources.sh
. "$ROOT/lib/sources.sh"
# shellcheck source=../lib/present.sh
. "$ROOT/lib/present.sh"
# shellcheck source=../lib/speech_text.sh
. "$ROOT/lib/speech_text.sh"
# shellcheck source=../lib/tts_eleven.sh
. "$ROOT/lib/tts_eleven.sh"
# shellcheck source=../lib/voice.sh
. "$ROOT/lib/voice.sh"

STATE_FILE="$WELCOME_STATE_DIR/last-run"
MUTE_FILE="$WELCOME_STATE_DIR/muted-on"
LOCK_DIR="$WELCOME_STATE_DIR/lock"

FORCE=0
PREVIEW=0
FROM_AGENT=0
TODAY="$(date '+%Y-%m-%d')"

usage() {
  cat <<'USAGE'
daily-welcome - a once-a-day spoken welcome and briefing for macOS

  daily-welcome                 run the daily check (greets only once a day)
  daily-welcome --force         greet now, whether or not today's is done
  daily-welcome --preview       greet now without marking the day as done
  daily-welcome --agent         same as bare, plus lock-screen/quiet-hour guards
  daily-welcome --status        what it would do, and when it last ran
  daily-welcome --set-key       store your ElevenLabs API key in the Keychain
  daily-welcome --test-voice    say one line now, and report which voice said it
  daily-welcome --voices        available voices, and which one it will use
  daily-welcome --hush          stop talking right now
  daily-welcome --mute-today    skip the rest of today
  daily-welcome --reset         forget that today's greeting happened
  daily-welcome --print         print the briefing as text and exit
  daily-welcome --quiet         this run, don't speak
  daily-welcome --present MODE  dialog | notification | both | stdout
USAGE
}

while [ $# -gt 0 ]; do
  case "$1" in
    -f|--force)   FORCE=1 ;;
    --preview)    FORCE=1; PREVIEW=1 ;;
    --agent|--launchd) FROM_AGENT=1 ;;
    --quiet)      WELCOME_SPEAK=0 ;;
    --present)    shift; WELCOME_PRESENT="${1:-dialog}" ;;
    --print)      FORCE=1; PREVIEW=1; WELCOME_PRESENT=stdout; WELCOME_SPEAK=0 ;;
    --status)     MODE=status ;;
    --set-key)    MODE=setkey ;;
    --test-voice) MODE=testvoice ;;
    --hush)       MODE=hush ;;
    --voices)     MODE=voices ;;
    --mute-today) MODE=mute ;;
    --reset)      MODE=reset ;;
    -h|--help)    usage; exit 0 ;;
    *) printf 'daily-welcome: unknown option %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done
MODE="${MODE:-run}"

mkdir -p "$WELCOME_STATE_DIR"

read_state() { [ -f "$STATE_FILE" ] && cat "$STATE_FILE" || printf 'never'; }

case "$MODE" in
  reset)
    rm -f "$STATE_FILE" "$MUTE_FILE"
    echo "daily-welcome: reset - the next check will greet you."
    exit 0
    ;;
  mute)
    printf '%s' "$TODAY" > "$MUTE_FILE"
    echo "daily-welcome: muted for the rest of $TODAY."
    exit 0
    ;;
  hush)
    hush
    exit 0
    ;;
  setkey)
    if ! have_cmd security; then
      echo "daily-welcome: no Keychain here; put the key in $WELCOME_ELEVEN_KEY_FILE" >&2
      exit 1
    fi
    printf 'ElevenLabs API key (input hidden): '
    stty -echo 2>/dev/null; IFS= read -r new_key; stty echo 2>/dev/null; printf '\n'
    if [ -z "$new_key" ]; then echo "daily-welcome: nothing entered." >&2; exit 1; fi
    security add-generic-password -a "$USER" -s "$WELCOME_KEYCHAIN_SERVICE" \
      -w "$new_key" -U >/dev/null || { echo "daily-welcome: could not save to Keychain." >&2; exit 1; }
    unset new_key
    rm -f "$WELCOME_STATE_DIR/eleven-voice-id"   # re-resolve against the new account
    echo "Saved to the login Keychain as \"$WELCOME_KEYCHAIN_SERVICE\"."
    echo "Check it works:  daily-welcome --test-voice"
    exit 0
    ;;
  testvoice)
    backend="$(tts_backend)"
    line="Welcome back, $WELCOME_NAME. $(_greeting_word). It's $(now_words), on $(today_words). Voice check complete."
    echo "Backend: $backend"
    if [ "$backend" = "elevenlabs" ]; then
      echo "Voice:   $WELCOME_ELEVEN_VOICE_NAME${WELCOME_ELEVEN_VOICE_ID:+ ($WELCOME_ELEVEN_VOICE_ID)}"
    else
      local_voice="$(resolve_voice)"
      echo "Voice:   ${local_voice:-system default}"
    fi
    echo "Saying:  $line"
    if [ "$backend" = "elevenlabs" ]; then
      eleven_speak "$line" || { echo "ElevenLabs failed - falling back to say. See $WELCOME_STATE_DIR/agent.log or run with the log visible." >&2; say_speak "$line"; }
    else
      say_speak "$line"
    fi
    exit 0
    ;;
  voices)
    echo "Backend in use: $(tts_backend)"
    echo
    if eleven_available; then
      echo "ElevenLabs is configured."
      echo "  voice: $WELCOME_ELEVEN_VOICE_NAME"
      echo "  id:    $(eleven_voice_id 2>/dev/null || echo '(not resolved - is the voice in your account?)')"
    else
      echo "ElevenLabs is not set up (no API key, or curl/afplay missing)."
      echo "  Add one with: daily-welcome --set-key"
    fi
    echo
    voice="$(resolve_voice)"
    echo "Local fallback voice: ${voice:-system default}"
    echo "Installed US English voices:"
    say -v '?' 2>/dev/null | grep -E '[[:space:]]en_US[[:space:]]' | sed 's/^/  /'
    exit 0
    ;;
  status)
    echo "name:          $WELCOME_NAME"
    echo "last greeting: $(read_state)"
    echo "today:         $TODAY"
    echo "muted today:   $([ -f "$MUTE_FILE" ] && [ "$(cat "$MUTE_FILE")" = "$TODAY" ] && echo yes || echo no)"
    echo "present:       $WELCOME_PRESENT"
    voice="$(resolve_voice)"
    echo "speak:         $WELCOME_SPEAK"
    echo "voice backend: $(tts_backend)"
    echo "hosted voice:  $WELCOME_ELEVEN_VOICE_NAME"
    echo "local voice:   ${voice:-system default}"
    echo "sections:      $WELCOME_SECTIONS"
    echo "tasks file:    $WELCOME_TASKS_FILE$([ -f "$WELCOME_TASKS_FILE" ] || echo '  (not present)')"
    echo "state dir:     $WELCOME_STATE_DIR"
    exit 0
    ;;
esac

# --- guards ----------------------------------------------------------------

if [ "$FORCE" -ne 1 ]; then
  if [ -f "$MUTE_FILE" ] && [ "$(cat "$MUTE_FILE")" = "$TODAY" ]; then
    exit 0
  fi
  if [ "$(read_state)" = "$TODAY" ]; then
    exit 0
  fi
fi

if [ "$FROM_AGENT" -eq 1 ] && [ "$FORCE" -ne 1 ]; then
  hour="$(date '+%H')"; hour="${hour#0}"; [ -z "$hour" ] && hour=0
  if [ "$hour" -lt "$WELCOME_EARLIEST_HOUR" ]; then
    exit 0   # too early to count as a new day; try again later
  fi
  if [ "$WELCOME_REQUIRE_UNLOCKED" = "1" ] && screen_is_locked; then
    exit 0   # don't spend the greeting on the lock screen
  fi
fi

# One greeting at a time, even if the agent and a manual run collide.
# A lock older than ten minutes is debris from a crashed run, not a rival.
if [ -d "$LOCK_DIR" ] && [ -z "$(find "$LOCK_DIR" -maxdepth 0 -mmin -10 2>/dev/null)" ]; then
  rmdir "$LOCK_DIR" 2>/dev/null
fi
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  exit 0
fi
trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT INT TERM

# --- gather ----------------------------------------------------------------

REM=""; CAL=""; TSK=""
for section in $WELCOME_SECTIONS; do
  case "$section" in
    reminders) REM="$(src_reminders)" ;;
    calendar)  CAL="$(src_calendar)" ;;
    tasks)     TSK="$(src_tasks)" ;;
  esac
done

SCREEN_TEXT="$(build_screen_text "$REM" "$CAL" "$TSK")"
TITLE="Welcome $WELCOME_NAME"

# --- deliver ---------------------------------------------------------------

if [ "$WELCOME_SPEAK" = "1" ]; then
  speak_async "$(build_spoken_briefing "$REM" "$CAL" "$TSK")"
fi

case "$WELCOME_PRESENT" in
  dialog)
    present_dialog "$TITLE" "$SCREEN_TEXT" "$WELCOME_DIALOG_TIMEOUT"
    ;;
  notification)
    present_notification "$TITLE" "$(date '+%A, %B %-d')" \
      "$(build_notification_line "$REM" "$CAL" "$TSK")"
    ;;
  both)
    present_notification "$TITLE" "$(date '+%A, %B %-d')" \
      "$(build_notification_line "$REM" "$CAL" "$TSK")"
    present_dialog "$TITLE" "$SCREEN_TEXT" "$WELCOME_DIALOG_TIMEOUT"
    ;;
  stdout|*)
    printf '%s\n\n%s\n' "$TITLE" "$SCREEN_TEXT"
    ;;
esac

if [ "$PREVIEW" -ne 1 ]; then
  printf '%s' "$TODAY" > "$STATE_FILE"
fi

# Don't exit mid-sentence: if the dialog was dismissed early, the voice
# still gets to finish.
if [ -n "${WELCOME_SPEAK_PID:-}" ]; then
  wait "$WELCOME_SPEAK_PID" 2>/dev/null
fi

welcome_log "greeted ($WELCOME_PRESENT, speak=$WELCOME_SPEAK)"
exit 0
