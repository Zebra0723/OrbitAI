#!/bin/bash
# daily-welcome - greets you once a day, the first time you open the Mac.
#
# Normally invoked by the background agent (see install.sh); run it by hand
# with --force to hear it, or --status to see what it thinks.

set -uo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

# shellcheck source=../lib/config.sh
. "$ROOT/lib/config.sh"
welcome_load_user_config
# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"
# shellcheck source=../lib/sources.sh
. "$ROOT/lib/sources.sh"
# shellcheck source=../lib/messages.sh
. "$ROOT/lib/messages.sh"
# shellcheck source=../lib/mail.sh
. "$ROOT/lib/mail.sh"
# shellcheck source=../lib/claude_jobs.sh
. "$ROOT/lib/claude_jobs.sh"
# shellcheck source=../lib/present.sh
. "$ROOT/lib/present.sh"
# shellcheck source=../lib/speech_text.sh
. "$ROOT/lib/speech_text.sh"
# shellcheck source=../lib/tts_eleven.sh
. "$ROOT/lib/tts_eleven.sh"
. "$ROOT/lib/memory.sh"
. "$ROOT/lib/macros.sh"
. "$ROOT/lib/nlu_openai.sh"
. "$ROOT/lib/tts_openai.sh"
. "$ROOT/lib/tts_piper.sh"
. "$ROOT/lib/speaker.sh"
# shellcheck source=../lib/voice.sh
. "$ROOT/lib/voice.sh"

LABEL_ID="${DAILY_WELCOME_LABEL:-com.arjun.dailywelcome}"
STATE_FILE="$WELCOME_STATE_DIR/last-run"
MUTE_FILE="$WELCOME_STATE_DIR/muted-on"
LOCK_DIR="$WELCOME_STATE_DIR/lock"

FORCE=0
PREVIEW=0
FROM_AGENT=0
TODAY="$(date '+%Y-%m-%d')"

usage() {
  cat <<'USAGE'
daily-welcome - a once-a-day spoken welcome and briefing for macOS

  daily-welcome                 run the daily check (greets only once a day)
  daily-welcome --force         greet now, whether or not today's is done
  daily-welcome --preview       greet now without marking the day as done
  daily-welcome --agent         same as bare, plus lock-screen/quiet-hour guards
  daily-welcome --status        what it would do, and when it last ran
  daily-welcome --doctor        check the whole install and say what to fix
  daily-welcome --test          run the test suite (a few seconds, no network)
  daily-welcome --reset-permissions   make macOS ask about access again
  daily-welcome --set-key       store your ElevenLabs API key in the Keychain
  daily-welcome --check-key     where the key is, and whether ElevenLabs likes it
  daily-welcome --brain claude | groq | gemini | ollama
  daily-welcome --brain test    ask it one real question and show the answer
  daily-welcome --brain models  what that service actually serves today
  daily-welcome --set-openai-key   store the key for whichever of those you chose
  daily-welcome --test-voice    say one line now, and report which voice said it
  daily-welcome --voice-probe   the same line six ways, to find what sounds wrong
  daily-welcome --emphasis on|off  lean on "overdue" and "unread" (off by default)
  daily-welcome --test-voice --plain   the same, with nothing done to the text
  daily-welcome --pause <ms>    how long it rests at a comma (210 is the default)
  daily-welcome --expression <0-150>   how much the built-in voice moves
  daily-welcome --voices        available voices, and which one it will use
  daily-welcome --voice-provider openai | elevenlabs | piper | say | auto
  daily-welcome --setup-piper   a free neural voice that runs on this Mac
  daily-welcome --best-voice    find the best voice this Mac has, and use it
  daily-welcome --mac-voices    the built-in voices, and how to get better ones
  daily-welcome --setup-speaker recognise who is speaking, by name
  daily-welcome --hush          stop talking right now
  daily-welcome --mute-today    skip the rest of today
  daily-welcome --reset         forget that today's greeting happened
  daily-welcome --print         print the briefing as text and exit
  daily-welcome --quiet         this run, don't speak
  daily-welcome --present MODE  dialog | notification | both | stdout
USAGE
}

while [ $# -gt 0 ]; do
  case "$1" in
    -f|--force)   FORCE=1 ;;
    --preview)    FORCE=1; PREVIEW=1 ;;
    --agent|--launchd) FROM_AGENT=1 ;;
    --quiet)      WELCOME_SPEAK=0 ;;
    --present)    shift; WELCOME_PRESENT="${1:-dialog}" ;;
    --print)      FORCE=1; PREVIEW=1; WELCOME_PRESENT=stdout; WELCOME_SPEAK=0 ;;
    --status)     MODE=status ;;
    --doctor)     exec "$ROOT/bin/doctor" ;;
    --test)       exec "$ROOT/tests/run" ;;
    --set-key)    MODE=setkey ;;
    --set-openai-key) MODE=setopenai ;;
    sk-*|sk_*)
      # A key given as an argument is written to ~/.zsh_history, shows up
      # in ps output, and gets pasted into chat logs by accident. Refuse it
      # and say why, rather than accepting it and leaving it lying around.
      echo "daily-welcome: don't pass the key as an argument - it is saved" >&2
      echo "in your shell history and visible to every process on the Mac." >&2
      echo >&2
      echo "Run the command on its own and paste at the prompt:" >&2
      echo "  daily-welcome --set-openai-key" >&2
      echo >&2
      echo "That key is now in your history. Revoke it and make a new one." >&2
      exit 2 ;;
    --check-key)  MODE=checkkey ;;
    --test-voice) MODE=testvoice ;;
    --voice-probe|--compare-voice) MODE=compare ;;
    --emphasis)   MODE=emphasis; shift; VOICE_ARG="${1:-}" ;;
    --hush)       MODE=hush ;;
    --reset-permissions) MODE=resetperms ;;
    --voices)     MODE=voices ;;
    --use-voice)  MODE=usevoice; shift; VOICE_ARG="${1:-}" ;;
    --voice-provider) MODE=provider; shift; VOICE_ARG="${1:-}" ;;
    --setup-piper) MODE=setuppiper ;;
    --mac-voices)  MODE=macvoices ;;
    --best-voice)  MODE=bestvoice ;;
    --brain)       shift
                   case "${1:-}" in
                     test|check) MODE=braintest ;;
                     models|list) MODE=brainmodels ;;
                     *) MODE=brain; VOICE_ARG="${1:-}" ;;
                   esac ;;
    --plain)       WELCOME_PAUSE=natural ;;
    --pause)       MODE=pause; shift; VOICE_ARG="${1:-}" ;;
    --expression)  MODE=expression; shift; VOICE_ARG="${1:-}" ;;
    --setup-speaker) MODE=setupspeaker ;;
    --mute-today) MODE=mute ;;
    --reset)      MODE=reset ;;
    -h|--help)    usage; exit 0 ;;
    *) printf 'daily-welcome: unknown option %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done
MODE="${MODE:-run}"

mkdir -p "$WELCOME_STATE_DIR"

read_state() { [ -f "$STATE_FILE" ] && cat "$STATE_FILE" || printf 'never'; }

case "$MODE" in
  reset)
    rm -f "$STATE_FILE" "$MUTE_FILE"
    echo "daily-welcome: reset - the next check will greet you."
    exit 0
    ;;
  mute)
    printf '%s' "$TODAY" > "$MUTE_FILE"
    echo "daily-welcome: muted for the rest of $TODAY."
    exit 0
    ;;
  hush)
    hush
    exit 0
    ;;
  resetperms)
    # macOS remembers a refusal as firmly as an approval, and a refused
    # app often disappears from the Automation list entirely - leaving
    # nothing to switch back on. Clearing the decisions makes it ask again.
    if ! have_cmd tccutil; then
      echo "daily-welcome: no tccutil on this system." >&2
      exit 1
    fi
    echo "Clearing remembered permission answers..."
    for service in AppleEvents Reminders Calendar AddressBook; do
      tccutil reset "$service" "$LABEL_ID" >/dev/null 2>&1 && echo "  $service (DailyWelcome)"
    done
    tccutil reset AppleEvents >/dev/null 2>&1 && echo "  AppleEvents (everything, including your terminal)"
    echo
    echo "Now run something that needs them and answer Allow:"
    echo "  daily-welcome --doctor"
    echo
    echo "Two things worth knowing:"
    echo "  - Each app asks separately. Allowing your terminal does not allow"
    echo "    the menu bar app, and the other way round."
    echo "  - The prompts are Automation prompts (\"wants to control Reminders\"),"
    echo "    which live under Privacy & Security > Automation, not under the"
    echo "    Reminders switch."
    exit 0
    ;;
  setkey)
    # Read the key. A pipe is honoured too, so a key can be handed over
    # without typing it: printf '%s' "$KEY" | daily-welcome --set-key
    if [ -t 0 ]; then
      printf 'ElevenLabs API key (input hidden): '
      stty -echo 2>/dev/null; IFS= read -r new_key; stty echo 2>/dev/null; printf '\n'
    else
      IFS= read -r new_key
    fi

    # Trim whatever came along for the ride. A copied key often carries a
    # trailing space or a stray quote, and the API rejects those without
    # saying why.
    new_key="$(printf '%s' "$new_key" | tr -d '\r\n\t ' | sed -e 's/^["'"'"']//' -e 's/["'"'"']$//')"
    if [ -z "$new_key" ]; then echo "daily-welcome: nothing entered." >&2; exit 1; fi

    stored=""
    if have_cmd security; then
      if security add-generic-password -a "${USER:-$(id -un)}" -s "$WELCOME_KEYCHAIN_SERVICE" \
           -w "$new_key" -U >/dev/null 2>&1; then
        # Storing is not the same as being able to read it back: the
        # Keychain can accept a write and then refuse the read.
        if [ "$(security find-generic-password -s "$WELCOME_KEYCHAIN_SERVICE" -w 2>/dev/null)" = "$new_key" ]; then
          stored="the login Keychain"
        fi
      fi
    fi

    if [ -z "$stored" ]; then
      if eleven_store_key_file "$new_key"; then
        stored="$WELCOME_ELEVEN_KEY_FILE"
        echo "The Keychain wouldn't hand the key back, so it's in a file instead"
        echo "(readable only by you)."
      else
        echo "daily-welcome: couldn't store the key anywhere." >&2
        exit 1
      fi
    fi

    rm -f "$WELCOME_STATE_DIR/eleven-voice-id"   # re-resolve against the new account
    echo "Saved to $stored."

    # Ask ElevenLabs whether it likes the key, rather than finding out at
    # the first thing you say.
    export WELCOME_ELEVEN_API_KEY="$new_key"
    code="$(eleven_check_key)"
    unset WELCOME_ELEVEN_API_KEY new_key
    case "$code" in
      200) echo "ElevenLabs accepted it."
           ("$ROOT/bin/orbit" warm >/dev/null 2>&1 &) 2>/dev/null
           echo "Hear it: daily-welcome --test-voice" ;;
      401|403) echo "ElevenLabs refused it (HTTP $code). The key is stored, but it"
               echo "won't work - check you copied the whole thing from"
               echo "elevenlabs.io > profile > API Keys." ;;
      000|"") echo "Couldn't reach ElevenLabs to check it. Stored anyway." ;;
      *) echo "ElevenLabs answered HTTP $code. Stored; try --test-voice." ;;
    esac
    # A new key deserves a fresh hearing, whatever the last one did.
    eleven_clear_rejected
    case "$code" in
      *) : ;;
    esac
    exit 0
    ;;
  setopenai)
    # The same storage as the ElevenLabs key: Keychain first, a file only
    # if the Keychain will not hand it back.
    if [ -t 0 ]; then
      printf 'OpenAI API key (input hidden): '
      stty -echo 2>/dev/null; IFS= read -r new_key; stty echo 2>/dev/null; printf '\n'
    else
      IFS= read -r new_key
    fi
    new_key="$(printf '%s' "$new_key" | tr -d '\r\n\t ' | sed -e 's/^["'"'"']//' -e 's/["'"'"']$//')"
    [ -z "$new_key" ] && { echo "daily-welcome: nothing entered." >&2; exit 1; }

    stored=""
    if have_cmd security &&
       security add-generic-password -a "${USER:-$(id -un)}" -s "$ORBIT_OPENAI_KEYCHAIN" \
         -w "$new_key" -U >/dev/null 2>&1 &&
       [ "$(security find-generic-password -s "$ORBIT_OPENAI_KEYCHAIN" -w 2>/dev/null)" = "$new_key" ]; then
      stored="the login Keychain"
    else
      mkdir -p "$(dirname "$ORBIT_OPENAI_KEY_FILE")"
      printf '%s' "$new_key" > "$ORBIT_OPENAI_KEY_FILE" && chmod 600 "$ORBIT_OPENAI_KEY_FILE" &&
        stored="$ORBIT_OPENAI_KEY_FILE"
    fi
    [ -z "$stored" ] && { echo "daily-welcome: couldn't store the key." >&2; exit 1; }
    echo "Saved to $stored."

    # Check it against a real request rather than leaving you to find out
    # the first time you say something.
    # Against the endpoint that is actually configured. Without passing
    # these, a Groq or Gemini key was tested against api.openai.com and
    # reported as broken - which is a good way to be told a working key
    # does not work.
    probe="$(OPENAI_API_KEY="$new_key" \
             ORBIT_OPENAI_BASE="$ORBIT_OPENAI_BASE" \
             ORBIT_OPENAI_MODEL="$ORBIT_OPENAI_MODEL" \
             python3 "$ROOT/lib/openai_intent.py" "turn the volume up" 2>&1)"
    case "$ORBIT_OPENAI_BASE" in
      *api.openai.com*) : ;;
      *) printf 'Checking against %s (%s).\n' "$ORBIT_OPENAI_BASE" "$ORBIT_OPENAI_MODEL" ;;
    esac
    unset new_key
    case "$probe" in
      system*) echo "OpenAI accepted it. Understanding is on." ;;
      *) echo "It stored, but the test request failed:"; printf '  %s\n' "$probe" ;;
    esac
    exit 0
    ;;
  checkkey)
    source_name="$(eleven_key_source)" || {
      echo "No key found in any of:"
      echo "  the WELCOME_ELEVEN_API_KEY variable"
      echo "  the login Keychain (service \"$WELCOME_KEYCHAIN_SERVICE\")"
      echo "  $WELCOME_ELEVEN_KEY_FILE"
      echo
      echo "Set one with: daily-welcome --set-key"
      exit 1
    }
    key="$(eleven_api_key)"
    echo "Key found in:  $source_name"
    # Never print the key; enough of it to recognise, no more.
    echo "Looks like:    ${#key} characters, ending ...${key: -4}"
    case "$key" in
      sk_*) echo "Format:        starts with sk_, as expected" ;;
      *)    echo "Format:        does NOT start with sk_ - is this the whole key?" ;;
    esac
    code="$(eleven_check_key)"
    case "$code" in
      200) echo "ElevenLabs:    accepted (HTTP 200)" ;;
      401|403) echo "ElevenLabs:    REFUSED (HTTP $code) - the key is wrong, expired, or partial" ;;
      000|"") echo "ElevenLabs:    no answer - network, or a proxy in the way" ;;
      *) echo "ElevenLabs:    HTTP $code" ;;
    esac
    exit 0
    ;;
  compare)
    # Every layer on its own, in order, with a gap between each.
    #
    # "The voice is weird" can mean any of four different things stacked
    # on top of each other, and guessing which one from a description has
    # not worked. This says the same sentence six ways and prints the
    # command that keeps whichever one sounded right.
    # Written without the apostrophe on purpose - speech_natural puts it
    # there, and a nested quote inside a command substitution is exactly
    # the thing bash 3.2 mis-parses.
    now_short="$(time_words "$(date '+%-H')" "$((10#$(date '+%M')))" 0)"
    line="$(speech_natural "$(_greeting_word), $WELCOME_NAME. It is $now_short, and you have two unread and one overdue.")"
    flat="It is $(now_words) on $(today_words), and you have two unread and one overdue."

    echo "Voice: $(resolve_voice || echo 'the System Settings voice')     Backend: $(tts_backend)"
    echo
    probe() {
      printf '     sent: %s\n' "$1"
      say_speak_raw "$1"
      sleep 1
    }
    # Speaks exactly what it is given, with nothing added.
    say_speak_raw() {
      local v; v="$(resolve_voice)"
      if [ -n "$v" ]; then say -v "$v" -r "$WELCOME_SPEAK_RATE" "$1" >/dev/null 2>&1
      else say -r "$WELCOME_SPEAK_RATE" "$1" >/dev/null 2>&1; fi
    }

    echo "1. Written English, no shaping at all - what it used to be"
    probe "$flat"
    echo "2. Spoken English, still no shaping - words only"
    probe "$line"
    echo "3. Plus shorter pauses at the commas - THIS IS THE DEFAULT NOW"
    probe "$(WELCOME_SAY_EMPHASIS=0 speech_pace "$line" say)"
    echo "4. Plus a lean on \"unread\" and \"overdue\""
    probe "$(WELCOME_SAY_EMPHASIS=1 speech_pace "$line" say)"
    echo "5. Plus some pitch movement"
    probe "[[pmod 60]] $(WELCOME_SAY_EMPHASIS=0 speech_pace "$line" say)"
    echo "6. Plus a lot of pitch movement - what it was until now"
    probe "[[pmod 78]] $(WELCOME_SAY_EMPHASIS=0 speech_pace "$line" say)"

    echo
    echo "If any of those read the square brackets OUT LOUD, that is the"
    echo "answer: this voice does not understand them and should not be"
    echo "sent them.  daily-welcome --pause natural  stops all of it."
    echo
    echo "Keep the one you liked:"
    echo "  3   nothing to do, that is what it does now"
    echo "  4   daily-welcome --emphasis on"
    echo "  5   daily-welcome --expression 60"
    echo "  6   daily-welcome --expression 78"
    echo "  1   daily-welcome --pause natural   (and tell me, because that would surprise me)"
    echo
    echo "All six still weird? Then it is the voice itself, not the shaping:"
    echo "  daily-welcome --mac-voices     a Premium version is a free download"
    echo "  daily-welcome --setup-piper    a free neural voice, no account"
    exit 0
    ;;
  testvoice)
    backend="$(tts_backend)"
    line="$(speech_natural "$(_greeting_word), $WELCOME_NAME. It's $(time_words "$(date '+%-H')" "$((10#$(date '+%M')))" 0). That is the voice you will hear.")"
    echo "Backend: $backend"
    case "$backend" in
      elevenlabs) echo "Voice:   $WELCOME_ELEVEN_VOICE_NAME${WELCOME_ELEVEN_VOICE_ID:+ ($WELCOME_ELEVEN_VOICE_ID)}" ;;
      openai)     echo "Voice:   $WELCOME_OPENAI_VOICE ($WELCOME_OPENAI_TTS_MODEL)" ;;
      piper)      echo "Voice:   $(basename "$WELCOME_PIPER_MODEL") (local, free)" ;;
      *)          local_voice="$(resolve_voice)"
                  echo "Voice:   ${local_voice:-system default}" ;;
    esac
    echo "Saying:  $line"
    # What the engine is actually handed, after pacing. If a pause marker
    # ever gets READ ALOUD instead of obeyed, this is where you see it.
    spoken="$(speech_pace "$line" "$backend")"
    [ "$backend" = "say" ] && spoken="$(_say_prosody)$spoken"
    [ "$spoken" != "$line" ] && echo "Sent:    $spoken"

    case "$backend" in
      elevenlabs)
        if ! eleven_speak "$line" 2> "$WELCOME_STATE_DIR/last-voice-error"; then
          echo
          echo "ElevenLabs didn't speak. What it said about it:"
          sed 's/^/  /' "$WELCOME_STATE_DIR/last-voice-error" 2>/dev/null | tail -5
          echo
          echo "Most likely: the voice isn't in your account (--voices lists what is),"
          echo "or the key is wrong (--set-key)."
          if openai_tts_available; then
            echo "Trying OpenAI instead."
            file="$(openai_tts_cache_path "$line")"
            if openai_tts_synthesize "$line" "$file" && play_file "$file"; then exit 0; fi
          fi
          if piper_available; then
            echo "Trying the local voice instead."
            file="$(piper_cache_path "$line")"
            if piper_synthesize "$line" "$file" && play_file "$file"; then exit 0; fi
          fi
          echo "Falling back to the built-in voice."
          say_speak "$line"
        fi ;;
      piper)
        file="$(piper_cache_path "$line")"
        if ! piper_synthesize "$line" "$file" || ! play_file "$file"; then
          echo
          echo "Piper didn't speak. What it said about it:"
          sed 's/^/  /' "$WELCOME_STATE_DIR/last-voice-error" 2>/dev/null | tail -5
          echo
          echo "Check the model: $WELCOME_PIPER_MODEL"
          echo "Or set it up again: daily-welcome --setup-piper"
          echo "Falling back to the built-in voice."
          say_speak "$line"
        fi ;;
      openai)
        file="$(openai_tts_cache_path "$line")"
        if ! openai_tts_synthesize "$line" "$file" || ! play_file "$file"; then
          echo
          echo "OpenAI didn't speak. What it said about it:"
          sed 's/^/  /' "$WELCOME_STATE_DIR/last-voice-error" 2>/dev/null | tail -5
          echo
          echo "Most likely the key (--set-openai-key) or the voice name (--voices)."
          echo "Falling back to the built-in voice."
          say_speak "$line"
        fi ;;
      *)
        echo
        echo "This is the built-in macOS voice."
        if ! eleven_api_key >/dev/null 2>&1 && ! openai_api_key >/dev/null 2>&1; then
          echo "No speech key is set. Either:"
          echo "  daily-welcome --set-key           ElevenLabs"
          echo "  daily-welcome --set-openai-key    OpenAI"
        fi
        say_speak "$line" ;;
    esac
    exit 0
    ;;
  setupspeaker)
    # Installs the library, turns the feature on, and says plainly what
    # switching it on means - which is that the microphone audio now
    # touches the disk.
    echo "Recognising who is speaking"
    echo
    echo "This keeps the last few seconds of microphone audio in a file on"
    echo "this Mac, so the voice can be matched after the fact. Nothing is"
    echo "uploaded and nothing leaves the machine, but the audio is written"
    echo "down, which it never was before. Turn it off again any time with"
    echo "  ORBIT_SPEAKER_ID=0"
    echo

    if ! speaker_installed; then
      venv="$(speaker_venv)"
      if [ ! -x "$venv/bin/python" ]; then
        echo "Making a place to put it..."
        if ! python3 -m venv "$venv"; then
          echo "daily-welcome: could not create a virtual environment at $venv" >&2
          echo "Is python3 installed? xcode-select --install" >&2
          exit 1
        fi
      fi
      echo "Installing the recogniser. This pulls in PyTorch, so it is a"
      echo "few hundred megabytes and takes a couple of minutes..."
      echo
      if ! "$venv/bin/pip" install --upgrade pip >/dev/null 2>&1; then : ; fi
      # setuptools 81 dropped pkg_resources, and something in this
      # dependency tree still imports it. Torch asks for setuptools>=77,
      # so pinning below 81 keeps everyone happy. Installed in the same
      # command as resemblyzer so pip resolves them together rather than
      # pulling 84 and then being argued down.
      if ! "$venv/bin/pip" install resemblyzer "setuptools<81"; then
        echo >&2
        echo "daily-welcome: pip could not install resemblyzer." >&2
        echo "The environment is at $venv if you want to look." >&2
        exit 1
      fi
    fi

    # An environment built before this was known will still have the
    # newer setuptools in it, and reinstalling resemblyzer alone will not
    # touch it.
    if ! speaker_installed; then
      case "$(speaker_run check 2>&1)" in
        *pkg_resources*)
          echo
          echo "Fixing setuptools - 81 and later dropped pkg_resources..."
          "$(speaker_venv)/bin/pip" install -q "setuptools<81" 2>&1 | tail -2
          ;;
      esac
    fi

    if ! speaker_installed; then
      echo >&2
      echo "Installed, but it will not load. The reason:" >&2
      speaker_run check 2>&1 | sed 's/^/  /' >&2
      echo >&2
      echo "Interpreter tried: $(_speaker_python)" >&2
      echo "Environment:       $(speaker_venv)" >&2
      echo >&2
      echo "If that is the wrong interpreter, point at the right one with" >&2
      echo "  ORBIT_SPEAKER_PYTHON=/full/path/to/python" >&2
      exit 1
    fi

    cfg="${WELCOME_CONFIG:-$HOME/.config/daily-welcome/config.sh}"
    mkdir -p "$(dirname "$cfg")"; touch "$cfg"
    grep -v '^ORBIT_SPEAKER_ID=' "$cfg" > "$cfg.tmp" 2>/dev/null || : > "$cfg.tmp"
    { cat "$cfg.tmp"; printf 'ORBIT_SPEAKER_ID="1"\n'; } > "$cfg"
    rm -f "$cfg.tmp"
    launchctl kickstart -k "gui/$(id -u)/${DAILY_WELCOME_LABEL:-com.arjun.dailywelcome}" >/dev/null 2>&1

    echo "Ready. Now enrol yourself - say a couple of sentences when it asks:"
    echo "  orbit voice enroll $WELCOME_NAME"
    echo
    echo "Then anyone else who uses it. To refuse a voice:"
    echo "  orbit voice ban <name>"
    exit 0
    ;;
  emphasis)
    case "$VOICE_ARG" in
      on|1|yes)  value=1 ;;
      off|0|no)  value=0 ;;
      *) echo "daily-welcome --emphasis on|off" >&2; exit 2 ;;
    esac
    cfg="${WELCOME_CONFIG:-$HOME/.config/daily-welcome/config.sh}"
    mkdir -p "$(dirname "$cfg")"; touch "$cfg"
    grep -v '^WELCOME_SAY_EMPHASIS=' "$cfg" > "$cfg.tmp" 2>/dev/null || : > "$cfg.tmp"
    { cat "$cfg.tmp"; printf 'WELCOME_SAY_EMPHASIS="%s"\n' "$value"; } > "$cfg"
    rm -f "$cfg.tmp"
    if [ "$value" = 1 ]; then
      echo "It will lean on \"overdue\", \"unread\", \"urgent\" and \"late\"."
    else
      echo "Emphasis off - every word said the same way."
    fi
    echo "Hear it: daily-welcome --test-voice"
    exit 0
    ;;
  expression)
    # One dial for how much the built-in voice moves, so it can be found
    # by ear instead of by reading Apple's speech synthesis notes.
    cfg="${WELCOME_CONFIG:-$HOME/.config/daily-welcome/config.sh}"
    mkdir -p "$(dirname "$cfg")"; touch "$cfg"
    case "${VOICE_ARG:-}" in
      ''|*[!0-9]*)
        echo "daily-welcome --expression <0-150>" >&2
        echo >&2
        echo "  How far the pitch moves across a sentence - the difference" >&2
        echo "  between reading and speaking. Only affects the built-in" >&2
        echo "  voices; a neural or Siri voice does its own prosody." >&2
        echo >&2
        echo "  0    monotone" >&2
        echo "  50   Apple's default" >&2
        echo "  78   livelier            (this is the default here)" >&2
        echo "  110  animated" >&2
        echo "  150  pantomime" >&2
        echo >&2
        echo "Now: $WELCOME_SAY_MODULATION" >&2
        exit 2 ;;
    esac
    grep -v '^WELCOME_SAY_MODULATION=' "$cfg" > "$cfg.tmp" 2>/dev/null || : > "$cfg.tmp"
    { cat "$cfg.tmp"; printf 'WELCOME_SAY_MODULATION="%s"\n' "$VOICE_ARG"; } > "$cfg"
    rm -f "$cfg.tmp"
    echo "Expression set to $VOICE_ARG."
    echo "Hear it: daily-welcome --test-voice"
    exit 0
    ;;
  pause)
    # One dial, so this can be tuned by ear in a few seconds rather than
    # by editing a config file between every try.
    cfg="${WELCOME_CONFIG:-$HOME/.config/daily-welcome/config.sh}"
    mkdir -p "$(dirname "$cfg")"; touch "$cfg"
    case "${VOICE_ARG:-}" in
      natural|none|short) key=WELCOME_PAUSE; value="$VOICE_ARG" ;;
      ''|*[!0-9]*)
        echo "daily-welcome --pause <milliseconds> | short | natural | none" >&2
        echo >&2
        echo "  --pause 210      a person's rest at a comma  (the default)" >&2
        echo "  --pause 320      slower, more deliberate" >&2
        echo "  --pause 120      brisk" >&2
        echo "  --pause natural  leave the text exactly as written" >&2
        echo "  --pause none     no comma rests at all" >&2
        echo >&2
        echo "Now: WELCOME_PAUSE=$WELCOME_PAUSE, WELCOME_PAUSE_MS=$WELCOME_PAUSE_MS" >&2
        exit 2 ;;
      *) key=WELCOME_PAUSE_MS; value="$VOICE_ARG" ;;
    esac
    grep -v "^$key=" "$cfg" > "$cfg.tmp" 2>/dev/null || : > "$cfg.tmp"
    { cat "$cfg.tmp"; printf '%s="%s"\n' "$key" "$value"; } > "$cfg"
    # Setting a length implies wanting the rests at all.
    if [ "$key" = "WELCOME_PAUSE_MS" ]; then
      grep -v '^WELCOME_PAUSE=' "$cfg" > "$cfg.tmp2" 2>/dev/null || : > "$cfg.tmp2"
      { cat "$cfg.tmp2"; printf 'WELCOME_PAUSE="short"\n'; } > "$cfg"
      rm -f "$cfg.tmp2"
    fi
    rm -f "$cfg.tmp"
    echo "$key set to $value."
    echo "Hear it: daily-welcome --test-voice"
    exit 0
    ;;
  brain)
    # Which service works out what you meant. Anything that speaks the
    # OpenAI chat-completions shape does, and two of them are free and
    # much faster than booting Claude Code for every sentence.
    cfg="${WELCOME_CONFIG:-$HOME/.config/daily-welcome/config.sh}"
    case "${VOICE_ARG:-}" in
      groq)    base="https://api.groq.com/openai/v1";  model="llama-3.1-8b-instant"
               where="console.groq.com/keys" ;;
      gemini)  base="https://generativelanguage.googleapis.com/v1beta/openai"
               model="gemini-2.0-flash";               where="aistudio.google.com/apikey" ;;
      ollama)  base="http://localhost:11434/v1";       model="llama3.2"
               where="nothing - it runs on this Mac" ;;
      claude|off)
               grep -v '^ORBIT_NLU=' "$cfg" > "$cfg.tmp" 2>/dev/null || : > "$cfg.tmp"
               { cat "$cfg.tmp"; printf 'ORBIT_NLU="claude"\n'; } > "$cfg"
               rm -f "$cfg.tmp"
               echo "Using Claude Code. No key, slower to start talking."
               exit 0 ;;
      *)
        echo "daily-welcome --brain claude | groq | gemini | ollama" >&2
        echo >&2
        echo "  groq    free, and the fastest of them        console.groq.com" >&2
        echo "  gemini  free tier                            aistudio.google.com" >&2
        echo "  ollama  entirely on this Mac, no account     ollama.com" >&2
        echo "  claude  no key at all - the default" >&2
        echo >&2
        echo "  now: $ORBIT_OPENAI_MODEL at $ORBIT_OPENAI_BASE" >&2
        exit 2 ;;
    esac

    # The named model is a starting guess. Providers retire models -
    # llama-3.3-70b-versatile was the one recommended here until Groq
    # retired it - so when there is a key, ask the endpoint what it will
    # actually serve today and take that instead. A config file naming a
    # dead model fails at the moment you speak, with an error nobody sees.
    if [ "$VOICE_ARG" != "ollama" ] && ORBIT_OPENAI_BASE="$base" openai_available 2>/dev/null; then
      live="$(ORBIT_OPENAI_BASE="$base" openai_pick_model 2>/dev/null)" || live=""
      if [ -n "$live" ] && [ "$live" != "$model" ]; then
        printf 'Asked %s what it serves: using %s.\n' "$VOICE_ARG" "$live"
        model="$live"
      fi
    fi

    mkdir -p "$(dirname "$cfg")"; touch "$cfg"
    grep -vE '^(ORBIT_OPENAI_BASE|ORBIT_OPENAI_MODEL|ORBIT_NLU)=' "$cfg" > "$cfg.tmp" 2>/dev/null \
      || : > "$cfg.tmp"
    {
      cat "$cfg.tmp"
      printf 'ORBIT_OPENAI_BASE="%s"\n' "$base"
      printf 'ORBIT_OPENAI_MODEL="%s"\n' "$model"
      printf 'ORBIT_NLU="openai"\n'
    } > "$cfg"
    rm -f "$cfg.tmp"

    printf 'Set: %s, model %s.\n' "$VOICE_ARG" "$model"
    echo

    # What will ACTUALLY happen now, which is not the same thing as what
    # was just written down. Without a key the model path is skipped in
    # silence and everything carries on exactly as before - so saying
    # "understanding now goes to Groq" would be a straight lie, and
    # "nothing happened" would be the entirely reasonable report.
    if [ "$VOICE_ARG" = "ollama" ]; then
      if curl -fsS --max-time 3 "$base/models" >/dev/null 2>&1; then
        echo "Ollama is answering. Understanding goes to it from now on."
      else
        echo "NOT IN USE YET: nothing is answering at $base."
        echo "  ollama serve"
        echo "  ollama pull $model"
      fi
    elif ORBIT_OPENAI_BASE="$base" ORBIT_OPENAI_MODEL="$model" openai_available; then
      echo "A key is stored, so understanding goes to $VOICE_ARG from now on."
      echo "Check it really works:  daily-welcome --brain test"
    else
      echo "NOT IN USE YET - there is no key, and without one this setting"
      echo "changes nothing at all. It will carry on as it did before."
      echo
      echo "  1. Get a key:  $where"
      echo "  2. Store it:   daily-welcome --set-openai-key"
      echo "  3. Check it:   daily-welcome --brain test"
      echo
      echo "$model is a starting guess. Once there is a key, --brain test"
      echo "asks $VOICE_ARG what it actually serves and settles on one."
    fi
    exit 0
    ;;
  brainmodels)
    printf 'What %s serves today:\n\n' "$ORBIT_OPENAI_BASE"
    if ! openai_available; then
      echo "  (no key stored, so it cannot be asked)"
      echo "  daily-welcome --set-openai-key"
      exit 1
    fi
    openai_models 2>/dev/null | sed 's/^/  /' || {
      echo "  (it would not answer)"; exit 1; }
    echo
    printf 'Orbit would choose: %s\n' "$(openai_pick_model 2>/dev/null || echo '<none usable>')"
    echo "Set another with: ORBIT_OPENAI_MODEL=... in your config"
    exit 0
    ;;
  braintest)
    # One real request, and whatever came back. "Did that do anything" is
    # not a question anybody should have to answer by feel.
    printf 'Endpoint: %s\nModel:    %s\n' "$ORBIT_OPENAI_BASE" "$ORBIT_OPENAI_MODEL"
    if ! openai_available; then
      echo
      echo "No key stored, so none of the above is being used."
      echo "  daily-welcome --set-openai-key"
      exit 1
    fi
    echo "Key:      found"
    echo
    echo 'Asking it: "put the volume up a bit"'
    key="$(openai_api_key)"
    started="$(date '+%s')"
    out="$(OPENAI_API_KEY="$key" \
           ORBIT_OPENAI_BASE="$ORBIT_OPENAI_BASE" \
           ORBIT_OPENAI_MODEL="$ORBIT_OPENAI_MODEL" \
           python3 "$ROOT/lib/openai_intent.py" "put the volume up a bit" 2>&1)"
    unset key
    printf 'It said:   %s\n' "${out:-<nothing>}"
    printf 'Took:      %ss\n' "$(( $(date '+%s') - started ))"
    echo
    case "$out" in
      system*|message*|ask*|chat*|claude*|mail*|readback*|command*|web*|none*)
        echo "Working. That is the shape the rest of Orbit expects." ;;
      *model*|*Model*|*decommission*|*not_found*|*404*)
        echo "The endpoint answered, but not with that model - retired, or"
        echo "never there. Asking it what it does serve."
        live="$(openai_pick_model 2>/dev/null)" || live=""
        if [ -n "$live" ]; then
          cfg="${WELCOME_CONFIG:-$HOME/.config/daily-welcome/config.sh}"
          mkdir -p "$(dirname "$cfg")"; touch "$cfg"
          grep -v '^ORBIT_OPENAI_MODEL=' "$cfg" > "$cfg.tmp" 2>/dev/null || : > "$cfg.tmp"
          { cat "$cfg.tmp"; printf 'ORBIT_OPENAI_MODEL="%s"\n' "$live"; } > "$cfg"
          rm -f "$cfg.tmp"
          printf '\nSwitched to %s. Run this again to check it.\n' "$live"
        else
          echo "It would not say. Everything it offers:"
          openai_models 2>/dev/null | sed 's/^/    /' | head -25
        fi ;;
      *401*|*403*|*nvalid*|*uthenti*)
        echo "The key was refused. Store the right one:"
        echo "  daily-welcome --set-openai-key" ;;
      *)
        echo "That is not an answer Orbit can use. The text above is what"
        echo "the endpoint actually said." ;;
    esac
    exit 0
    ;;
  bestvoice)
    # One command that finds the best voice this Mac can actually use and
    # switches to it, because "here are five options, three of them need
    # a download" has not got anybody a better voice yet.
    #
    # Ordered by how much they sound like a person, not by how clever
    # they are to set up.
    echo "Looking for the best voice on this Mac."
    echo

    if eleven_available; then
      echo "  ElevenLabs is working. Nothing beats it and nothing else is close."
      "$0" --voice-provider elevenlabs >/dev/null 2>&1
      echo "  Using it."
      echo; echo "Hear it: daily-welcome --test-voice"; exit 0
    fi

    if piper_available 2>/dev/null; then
      echo "  Piper is set up: neural, local, free, no account."
      "$0" --voice-provider piper >/dev/null 2>&1
      echo "  Using it."
      echo; echo "Hear it: daily-welcome --test-voice"; exit 0
    fi

    # Nothing neural is installed. The best remaining thing is a Siri
    # voice, which IS neural and is already on most Macs - but `say`
    # cannot name one, so it has to be the System Voice and we use that.
    echo "  No neural voice is set up, so this is as good as it gets for now:"
    echo
    # And whatever the provider was set to before, it is not that now.
    # An explicit WELCOME_TTS beats every default, so a setting written
    # weeks ago keeps a voice in use long after it stopped being wanted.
    "$0" --voice-provider say >/dev/null 2>&1
    installed="$(_installed_voices)"
    current="$(resolve_voice)"
    base="$(printf '%s' "${current:-}" | sed -E 's/ \((Premium|Enhanced)\)$//')"

    upgrade=""
    [ -n "$base" ] && upgrade="$(printf '%s\n' "$installed" | grep -F "$base (Premium)" | head -1)"
    [ -z "$upgrade" ] && [ -n "$base" ] && upgrade="$(printf '%s\n' "$installed" | grep -F "$base (Enhanced)" | head -1)"
    if [ -n "$upgrade" ]; then
      "$0" --use-voice "$upgrade" >/dev/null 2>&1
      echo "  Switched to $upgrade - the better version of the voice you were on."
    else
      best="$(printf '%s\n' "$installed" | grep -F "(Premium)" | head -1)"
      if [ -n "$best" ]; then
        echo "  There is a Premium voice installed: $best"
        echo "  Use it:  daily-welcome --use-voice \"$best\""
      else
        echo "  Every voice here is the plain compact kind, which is the one"
        echo "  that sounds like a robot. That is not something wording or"
        echo "  timing can fix - it is the synthesiser."
      fi
    fi

    echo
    echo "To actually sound like a person, in order:"
    echo
    echo "  1. A Siri voice. Neural, free, already on this Mac. \`say\` cannot"
    echo "     pick one by name, so it has to be the system voice:"
    echo "       System Settings > Accessibility > Spoken Content > System Voice"
    echo "       > Manage Voices... > English > tick a Siri voice > Done"
    echo "       daily-welcome --use-voice system"
    echo
    echo "  2. ElevenLabs. The only one that sounds like it means it. The free"
    echo "     tier is ten thousand characters a month, which is about a month"
    echo "     of briefings:"
    echo "       elevenlabs.io > sign up > Profile > API key"
    echo "       daily-welcome --set-key"
    echo
    echo "  3. Piper. Neural, local, free, no account, nothing leaves the Mac:"
    echo "       daily-welcome --setup-piper"
    echo
    echo "  4. A Premium \`say\` voice. Better than compact, still not a person:"
    echo "       daily-welcome --mac-voices"
    exit 0
    ;;
  macvoices)
    # Every Premium and Enhanced voice on the Mac, and then the one thing
    # worth knowing: whether the voice you are using has a better version
    # of ITSELF available.
    #
    # This used to filter both lists through a whitelist of American
    # English names - ava, zoe, allison and so on - so somebody using
    # Rishi was shown a list with no Rishi in it and told "none
    # installed". The command that exists to fix your voice ignored your
    # voice.
    echo "Voices installed on this Mac"
    echo
    installed="$(_installed_voices)"
    prem="$(printf '%s\n' "$installed" | grep -F "(Premium)")"
    enh="$(printf '%s\n' "$installed" | grep -F "(Enhanced)")"

    if [ -n "$prem" ]; then
      echo "  Premium  (the best downloadable ones)"
      printf '%s\n' "$prem" | sed 's/^/    /'
    else
      echo "  Premium  none installed  <-- this is almost certainly your problem"
    fi
    echo
    if [ -n "$enh" ]; then
      echo "  Enhanced (better than the default, smaller download)"
      printf '%s\n' "$enh" | sed 's/^/    /'
    else
      echo "  Enhanced none installed"
    fi
    echo

    current="$(resolve_voice)"
    echo "  In use right now: ${current:-the System Settings voice}"
    echo

    # The actionable line. A voice name is "Rishi" or "Rishi (Premium)";
    # the base name is what has better versions.
    if [ -n "$current" ]; then
      base="$(printf '%s' "$current" | sed -E 's/ \((Premium|Enhanced)\)$//')"
      case "$current" in
        *"(Premium)")
          echo "  You are already on the best version of $base." ;;
        *)
          better="$(printf '%s\n' "$installed" | grep -F "$base (")"
          if [ -n "$better" ]; then
            echo "  There is a better $base installed. Switch to it:"
            printf '%s\n' "$better" | sed 's/^/    daily-welcome --use-voice "/; s/$/"/'
          else
            echo "  $base has no Enhanced or Premium version installed, which is"
            echo "  why it sounds the way it does. It is a free download:"
            echo "    System Settings > Accessibility > Spoken Content > System Voice"
            echo "    > Manage Voices... > find $base > tick Premium > Done"
            echo "  Then:  daily-welcome --use-voice \"$base (Premium)\""
          fi ;;
      esac
      echo
    fi

    echo "Any other voice, free, no account:"
    echo "  System Settings > Accessibility > Spoken Content > System Voice"
    echo "  > Manage Voices... > tick a Premium voice > Done"
    echo
    echo "  The Siri voices in that same list are the best of the lot, but"
    echo "  \`say\` cannot pick them by name - set one as your System Voice"
    echo "  and then run:  daily-welcome --use-voice system"
    echo
    echo "Then:  daily-welcome --test-voice"
    exit 0
    ;;
  setuppiper)
    # A free neural voice, in two steps, without hunting through docs.
    dir="$HOME/.config/daily-welcome/piper"
    model="$dir/voice.onnx"
    base="https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US"
    # amy-medium: American, clear, and small enough to fetch in seconds.
    voice_path="amy/medium/en_US-amy-medium.onnx"

    if ! piper_bin >/dev/null 2>&1; then
      echo "Piper isn't installed yet. It ships on PyPI, not in Homebrew:"
      echo
      echo "  brew install pipx"
      echo "  pipx install piper-tts"
      echo
      echo "Or, without pipx:"
      echo "  python3 -m pip install --user piper-tts"
      echo
      echo "Then run this again. If it is installed but not found, point at"
      echo "it directly:  WELCOME_PIPER_BIN=/full/path/to/piper"
      exit 1
    fi

    if [ -s "$model" ]; then
      echo "Voice model already here: $model"
    else
      mkdir -p "$dir" || exit 1
      echo "Fetching a voice (about 60MB)..."
      if ! curl -fsSL --retry 2 -o "$model" "$base/$voice_path"; then
        rm -f "$model"
        echo "daily-welcome: couldn't download the voice model." >&2
        echo "Get any .onnx from huggingface.co/rhasspy/piper-voices and put it at:" >&2
        echo "  $model" >&2
        echo "with its .onnx.json alongside." >&2
        exit 1
      fi
      if ! curl -fsSL --retry 2 -o "$model.json" "$base/$voice_path.json"; then
        rm -f "$model" "$model.json"
        echo "daily-welcome: got the voice but not its settings file." >&2
        exit 1
      fi
      echo "Saved to $model"
    fi

    cfg="${WELCOME_CONFIG:-$HOME/.config/daily-welcome/config.sh}"
    mkdir -p "$(dirname "$cfg")"; touch "$cfg"
    grep -v '^WELCOME_\(TTS\|PIPER_MODEL\)=' "$cfg" > "$cfg.tmp" 2>/dev/null || : > "$cfg.tmp"
    {
      cat "$cfg.tmp"
      printf 'WELCOME_PIPER_MODEL="%s"\n' "$model"
      printf 'WELCOME_TTS="piper"\n'
    } > "$cfg"
    rm -f "$cfg.tmp"
    echo
    echo "Voice provider set to piper. No key, no cost, nothing leaves this Mac."
    echo "Hear it: daily-welcome --test-voice"
    exit 0
    ;;
  provider)
    # Switching which service speaks, without opening a config file.
    cfg="${WELCOME_CONFIG:-$HOME/.config/daily-welcome/config.sh}"
    mkdir -p "$(dirname "$cfg")"; touch "$cfg"
    case "${VOICE_ARG:-}" in
      openai)
        if ! openai_api_key >/dev/null 2>&1; then
          echo "daily-welcome: no OpenAI key yet. Run: daily-welcome --set-openai-key" >&2
          exit 1
        fi ;;
      elevenlabs)
        if ! eleven_api_key >/dev/null 2>&1; then
          echo "daily-welcome: no ElevenLabs key yet. Run: daily-welcome --set-key" >&2
          exit 1
        fi ;;
      piper)
        if ! piper_available; then
          echo "daily-welcome: piper isn't set up yet. Run: daily-welcome --setup-piper" >&2
          exit 1
        fi ;;
      say|auto) : ;;
      *)
        echo "daily-welcome --voice-provider openai | elevenlabs | piper | say | auto" >&2
        exit 2 ;;
    esac
    grep -v '^WELCOME_TTS=' "$cfg" > "$cfg.tmp" 2>/dev/null || : > "$cfg.tmp"
    { cat "$cfg.tmp"; printf 'WELCOME_TTS="%s"\n' "$VOICE_ARG"; } > "$cfg"
    rm -f "$cfg.tmp"
    export WELCOME_TTS="$VOICE_ARG"
    echo "Voice provider set to $VOICE_ARG (now: $(tts_backend))."
    if [ "$VOICE_ARG" = "openai" ]; then
      echo "Voice: $WELCOME_OPENAI_VOICE   (change it: daily-welcome --use-voice nova)"
    fi
    echo "Hear it: daily-welcome --test-voice"
    exit 0
    ;;
  voices)
    echo "Backend in use: $(tts_backend)"
    echo
    if eleven_available; then
      echo "ElevenLabs key: found"
      echo "Wanted voice:   $WELCOME_ELEVEN_VOICE_NAME"
      resolved="$(eleven_voice_id 2>/dev/null)"
      if [ -n "$resolved" ]; then
        echo "Resolved to:    $resolved"
      else
        echo "Resolved to:    NOT FOUND - this voice isn't in your account."
      fi
      echo
      echo "Voices in your account:"
      listing="$(eleven_list_voices 2>/dev/null)"
      if [ -n "$listing" ]; then
        printf '%s\n' "$listing" | awk -F'\t' '{ printf "  %-32s %s\n", $1, $2 }'
        echo
        echo "Use one:  daily-welcome --use-voice \"<name>\""
      else
        echo "  (couldn't list them - is the key valid?)"
      fi
    else
      echo "ElevenLabs is not set up (no API key, or curl/afplay missing)."
      echo "  Add one with: daily-welcome --set-key"
    fi
    echo
    if openai_tts_available; then
      echo "OpenAI voices (daily-welcome --voice-provider openai to switch):"
      openai_tts_voices | sed 's/^/  /'
      echo "  in use: $WELCOME_OPENAI_VOICE"
    else
      echo "OpenAI speech is not set up. Add a key: daily-welcome --set-openai-key"
    fi
    echo
    voice="$(resolve_voice)"
    echo "Local fallback voice: ${voice:-system default}"
    exit 0
    ;;
  usevoice)
    # "system", or any installed macOS voice, when the local voice is the
    # one speaking. Without this there was no way to choose among them
    # except editing the config by hand.
    if [ "$(tts_backend)" = "say" ] || [ "${VOICE_ARG:-}" = "system" ]; then
      if [ -z "${VOICE_ARG:-}" ]; then
        echo "daily-welcome: --use-voice needs a name. What is installed:" >&2
        _installed_voices | sed 's/^/  /' >&2
        exit 2
      fi
      if [ "$VOICE_ARG" != "system" ] && ! _installed_voices | grep -Fxq "$VOICE_ARG"; then
        echo "daily-welcome: no voice called \"$VOICE_ARG\" on this Mac." >&2
        echo "See what there is, and how to get more: daily-welcome --mac-voices" >&2
        exit 1
      fi
      cfg="${WELCOME_CONFIG:-$HOME/.config/daily-welcome/config.sh}"
      mkdir -p "$(dirname "$cfg")"; touch "$cfg"
      grep -v '^WELCOME_VOICE=' "$cfg" > "$cfg.tmp" 2>/dev/null || : > "$cfg.tmp"
      { cat "$cfg.tmp"; printf 'WELCOME_VOICE="%s"\n' "$VOICE_ARG"; } > "$cfg"
      rm -f "$cfg.tmp"
      if [ "$VOICE_ARG" = "system" ]; then
        echo "Now using whatever voice System Settings is set to."
        echo "Set a Siri voice there and this is how you hear it."
      else
        echo "Voice set to \"$VOICE_ARG\"."
      fi
      echo "Hear it: daily-welcome --test-voice"
      exit 0
    fi

    if [ "$(tts_backend)" = "openai" ]; then
      if [ -z "${VOICE_ARG:-}" ]; then
        echo "daily-welcome: --use-voice needs a name, e.g. --use-voice nova" >&2
        openai_tts_voices | sed 's/^/  /' >&2
        exit 2
      fi
      wanted="$(printf '%s' "$VOICE_ARG" | tr '[:upper:]' '[:lower:]')"
      if ! openai_tts_voices | awk '{print $1}' | grep -qx "$wanted"; then
        echo "daily-welcome: OpenAI has no voice called \"$VOICE_ARG\". It has:" >&2
        openai_tts_voices | sed 's/^/  /' >&2
        exit 1
      fi
      cfg="${WELCOME_CONFIG:-$HOME/.config/daily-welcome/config.sh}"
      mkdir -p "$(dirname "$cfg")"; touch "$cfg"
      grep -v '^WELCOME_OPENAI_VOICE=' "$cfg" > "$cfg.tmp" 2>/dev/null || : > "$cfg.tmp"
      { cat "$cfg.tmp"; printf 'WELCOME_OPENAI_VOICE="%s"\n' "$wanted"; } > "$cfg"
      rm -f "$cfg.tmp"
      echo "OpenAI voice set to $wanted."
      echo "Hear it: daily-welcome --test-voice"
      exit 0
    fi

    if ! eleven_available; then
      echo "daily-welcome: set your ElevenLabs key first (--set-key)." >&2
      exit 1
    fi
    if [ -z "${VOICE_ARG:-}" ]; then
      echo "daily-welcome: --use-voice needs a name, e.g. --use-voice \"Veda Sky\"" >&2
      exit 2
    fi
    # A raw voice id is accepted as-is: library voices that aren't in your
    # account never show up in the listing, but they speak perfectly well.
    case "$VOICE_ARG" in
      *[!A-Za-z0-9]*) : ;;
      ??????????*)
        cfg="${WELCOME_CONFIG:-$HOME/.config/daily-welcome/config.sh}"
        mkdir -p "$(dirname "$cfg")"; touch "$cfg"
        grep -v '^WELCOME_ELEVEN_VOICE_ID=' "$cfg" > "$cfg.tmp" 2>/dev/null || : > "$cfg.tmp"
        { cat "$cfg.tmp"; printf 'WELCOME_ELEVEN_VOICE_ID="%s"\n' "$VOICE_ARG"; } > "$cfg"
        rm -f "$cfg.tmp" "$WELCOME_STATE_DIR/eleven-voice-id"
        echo "Voice id set to $VOICE_ARG."
        echo "Hear it: daily-welcome --test-voice"
        exit 0 ;;
    esac

    listing="$(eleven_list_voices 2>/dev/null)"
    match="$(printf '%s\n' "$listing" | awk -F'\t' -v want="$(printf '%s' "$VOICE_ARG" | tr '[:upper:]' '[:lower:]')" '
      tolower($1) == want { print; found = 1; exit }
      END { if (!found) exit 1 }')" || \
    match="$(printf '%s\n' "$listing" | awk -F'\t' -v want="$(printf '%s' "$VOICE_ARG" | tr '[:upper:]' '[:lower:]')" '
      index(tolower($1), want) { print; exit }')"

    if [ -z "$match" ]; then
      echo "daily-welcome: no voice matching \"$VOICE_ARG\" in your account." >&2
      echo "Run --voices to see what's there." >&2
      exit 1
    fi

    new_name="$(printf '%s' "$match" | cut -f1)"
    new_id="$(printf '%s' "$match" | cut -f2)"
    cfg="${WELCOME_CONFIG:-$HOME/.config/daily-welcome/config.sh}"
    mkdir -p "$(dirname "$cfg")"
    touch "$cfg"
    # Replace any existing setting rather than stacking a second one.
    grep -v '^WELCOME_ELEVEN_VOICE_\(NAME\|ID\)=' "$cfg" > "$cfg.tmp" 2>/dev/null || : > "$cfg.tmp"
    {
      cat "$cfg.tmp"
      printf 'WELCOME_ELEVEN_VOICE_NAME=%s\n' "\"$new_name\""
      printf 'WELCOME_ELEVEN_VOICE_ID=%s\n' "\"$new_id\""
    } > "$cfg"
    rm -f "$cfg.tmp" "$WELCOME_STATE_DIR/eleven-voice-id"
    echo "Voice set to \"$new_name\" ($new_id)."
    echo "Hear it: daily-welcome --test-voice"
    exit 0
    ;;
  status)
    echo "name:          $WELCOME_NAME"
    echo "last greeting: $(read_state)"
    echo "today:         $TODAY"
    echo "muted today:   $([ -f "$MUTE_FILE" ] && [ "$(cat "$MUTE_FILE")" = "$TODAY" ] && echo yes || echo no)"
    echo "present:       $WELCOME_PRESENT"
    voice="$(resolve_voice)"
    echo "speak:         $WELCOME_SPEAK"
    # Which service works out what you meant, and whether it is really
    # being used - a configured endpoint with no key is skipped in
    # silence, which looks exactly like a setting that did nothing.
    if [ "$ORBIT_NLU" = "rules" ] || [ "$ORBIT_NLU" = "off" ]; then
      echo "understanding: rules only, no model"
    elif [ "$ORBIT_NLU" = "openai" ] && openai_available 2>/dev/null; then
      echo "understanding: $ORBIT_OPENAI_MODEL at $ORBIT_OPENAI_BASE"
    elif [ "$ORBIT_NLU" = "openai" ]; then
      echo "understanding: $ORBIT_OPENAI_BASE is set but has NO KEY - not in use"
    else
      echo "understanding: Claude Code"
    fi
    echo "voice backend: $(tts_backend)"
    echo "hosted voice:  $WELCOME_ELEVEN_VOICE_NAME"
    echo "local voice:   ${voice:-system default}"
    echo "sections:      $WELCOME_SECTIONS"
    echo "tasks file:    $WELCOME_TASKS_FILE$([ -f "$WELCOME_TASKS_FILE" ] || echo '  (not present)')"
    echo "state dir:     $WELCOME_STATE_DIR"
    exit 0
    ;;
esac

# --- guards ----------------------------------------------------------------

if [ "$FORCE" -ne 1 ]; then
  if [ -f "$MUTE_FILE" ] && [ "$(cat "$MUTE_FILE")" = "$TODAY" ]; then
    exit 0
  fi
  if [ "$(read_state)" = "$TODAY" ]; then
    exit 0
  fi
fi

if [ "$FROM_AGENT" -eq 1 ] && [ "$FORCE" -ne 1 ]; then
  hour="$(date '+%H')"; hour="${hour#0}"; [ -z "$hour" ] && hour=0
  if [ "$hour" -lt "$WELCOME_EARLIEST_HOUR" ]; then
    exit 0   # too early to count as a new day; try again later
  fi
  if [ "$WELCOME_REQUIRE_UNLOCKED" = "1" ] && screen_is_locked; then
    exit 0   # don't spend the greeting on the lock screen
  fi
  if on_a_call; then
    exit 0   # you're on a call; the greeting keeps until you aren't
  fi
  if enrolling_now; then
    exit 0   # a voice is being recorded; do not talk into it
  fi
fi

# One greeting at a time, even if the agent and a manual run collide.
# A lock older than ten minutes is debris from a crashed run, not a rival.
if [ -d "$LOCK_DIR" ] && [ -z "$(find "$LOCK_DIR" -maxdepth 0 -mmin -10 2>/dev/null)" ]; then
  rmdir "$LOCK_DIR" 2>/dev/null
fi
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  exit 0
fi
trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT INT TERM

# --- gather ----------------------------------------------------------------

REM=""; CAL=""; TSK=""; MSG=""; MAIL=""; CLD=""
for section in $WELCOME_SECTIONS; do
  case "$section" in
    reminders) REM="$(src_reminders)" ;;
    calendar)  CAL="$(src_calendar)" ;;
    messages)  MSG="$(src_messages)" ;;
    mail)      MAIL="$(src_mail)" ;;
    claude)    CLD="$(src_claude)" ;;
    tasks)     TSK="$(src_tasks)" ;;
  esac
done

SCREEN_TEXT="$(build_screen_text "$REM" "$CAL" "$TSK" "$MSG" "$MAIL" "$CLD")"
TITLE="Welcome $WELCOME_NAME"

# --- deliver ---------------------------------------------------------------

if [ "$WELCOME_SPEAK" = "1" ]; then
  speak_async "$(build_spoken_briefing "$REM" "$CAL" "$TSK" "$MSG" "$MAIL" "$CLD")"
fi

NOTIFY_LINE="$(build_notification_line "$REM" "$CAL" "$TSK" "$MSG" "$MAIL" "$CLD")"

case "$WELCOME_PRESENT" in
  dialog)
    present_dialog "$TITLE" "$SCREEN_TEXT" "$WELCOME_DIALOG_TIMEOUT"
    ;;
  notification)
    present_notification "$TITLE" "$(date '+%A, %B %-d')" "$NOTIFY_LINE"
    ;;
  both)
    present_notification "$TITLE" "$(date '+%A, %B %-d')" "$NOTIFY_LINE"
    present_dialog "$TITLE" "$SCREEN_TEXT" "$WELCOME_DIALOG_TIMEOUT"
    ;;
  stdout|*)
    printf '%s\n\n%s\n' "$TITLE" "$SCREEN_TEXT"
    ;;
esac

if [ "$PREVIEW" -ne 1 ]; then
  printf '%s' "$TODAY" > "$STATE_FILE"
  # Claude's results have now been delivered; don't repeat them tomorrow.
  claude_jobs_mark_reported
fi

# Don't exit mid-sentence: if the dialog was dismissed early, the voice
# still gets to finish.
if [ -n "${WELCOME_SPEAK_PID:-}" ]; then
  wait "$WELCOME_SPEAK_PID" 2>/dev/null
fi

welcome_log "greeted ($WELCOME_PRESENT, speak=$WELCOME_SPEAK)"
exit 0
