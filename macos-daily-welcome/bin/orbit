#!/bin/bash
# orbit - the voice command side of daily-welcome.
#
# Everything runs in two phases. `orbit plan "<transcript>"` works out what
# you meant and says it back; `orbit run <token>` is the only thing that
# actually sends, dispatches, or changes anything. The listener in the menu
# bar app puts your spoken yes or no between the two.
#
# Read-only commands ("what's on my calendar") skip the second phase, since
# there's nothing to confirm.

set -uo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

. "$ROOT/lib/config.sh"
welcome_load_user_config
. "$ROOT/lib/common.sh"
. "$ROOT/lib/sources.sh"
. "$ROOT/lib/messages.sh"
. "$ROOT/lib/mail.sh"
. "$ROOT/lib/contacts.sh"
. "$ROOT/lib/claude_jobs.sh"
. "$ROOT/lib/system.sh"
. "$ROOT/lib/freeform.sh"
. "$ROOT/lib/present.sh"
. "$ROOT/lib/speech_text.sh"
. "$ROOT/lib/tts_eleven.sh"
. "$ROOT/lib/voice.sh"
. "$ROOT/lib/intents.sh"
. "$ROOT/lib/context.sh"
. "$ROOT/lib/ask.sh"
. "$ROOT/lib/tone.sh"
. "$ROOT/lib/macros.sh"
. "$ROOT/lib/watch.sh"
. "$ROOT/lib/nlu_openai.sh"
. "$ROOT/lib/emoji.sh"
. "$ROOT/lib/memory.sh"

PLAN_DIR="$WELCOME_STATE_DIR/plans"
mkdir -p "$PLAN_DIR" 2>/dev/null

# Everything orbit says is a reply to something just said out loud, so it
# is judged on how quickly it starts talking. The briefing keeps the
# better-sounding, slower model; this side takes the fast one.
WELCOME_ELEVEN_MODEL="$WELCOME_ELEVEN_FAST_MODEL"

usage() {
  cat <<'USAGE'
orbit - voice commands for daily-welcome

  orbit plan "<what you said>"   work out the action, say it back, return a token
  orbit run <token>              carry out a planned action
  orbit cancel <token>           drop it
  orbit say "<text>"             speak something in the Orbit voice
  orbit hush                     stop talking right now
  orbit listen [status|on|off|pause|resume|restart]   the microphone
  orbit warm                     pre-render the lines it says most
  orbit greeting                 the line for a wake word with no command
  orbit console                  open the OrbitAI console in a browser
  orbit memory [show|add|forget|clear]   what it remembers about you
  orbit log                      what it heard, how it read it, how long it took
  orbit selftest                 check every feature in the place it runs
  orbit debug                    one command, everything worth pasting back
  orbit examples                 phrasings it understands

Plan and run print one line of JSON: {"speak":"...","confirm":true,"token":"..."}
USAGE
}

# --- output helpers --------------------------------------------------------

emit() {
  # emit SPEAK CONFIRM TOKEN
  #
  # The audio is rendered here, while the caller is already waiting, and
  # handed over as a path. Speaking used to mean launching a second shell
  # that re-read every config file and then started afplay - on a one-word
  # answer that overhead was most of the delay.
  local audio=""
  # An action can deliberately have nothing to say - "stop talking" being
  # the obvious one. Rendering silence would cost a network round trip.
  if [ -n "$1" ]; then
    audio="$(speak_to_file "$1" 2>/dev/null)" || audio=""
  fi
  printf '{"speak":"%s","audio":"%s","confirm":%s,"token":"%s","end":%s}\n' \
    "$(json_escape "$1")" "$(json_escape "$audio")" "$2" "$3" "${4:-false}"
}

new_token() {
  printf '%s%s' "$(date '+%H%M%S')" "$(od -An -N2 -tu2 /dev/urandom 2>/dev/null | tr -d ' \n')"
}

plan_file() { printf '%s/%s.plan' "$PLAN_DIR" "$1"; }

# Plans are single-use and short-lived: an old yes shouldn't fire a
# command you gave twenty minutes ago.
prune_plans() {
  find "$PLAN_DIR" -name '*.plan' -mmin "+$ORBIT_PLAN_TTL_MINUTES" -delete 2>/dev/null
}

save_plan() {
  local token="$1"; shift
  printf '%s\n' "$@" > "$(plan_file "$token")"
}

# --- planning --------------------------------------------------------------

plan_message() {
  local who="$1" body="$2" handle token
  # "with a fire emoji" is an instruction about the message, not part of it.
  body="$(emoji_expand "$body")"

  if ! handle="$(contact_handle "$who")"; then
    emit "I couldn't find $who in your contacts. Add a nickname to your contacts file and try again." false ""
    return 0
  fi

  token="$(new_token)"
  save_plan "$token" "INTENT=message" \
    "HANDLE=$(printf '%s' "$handle")" \
    "WHO=$(printf '%s' "$who")" \
    "BODY=$(printf '%s' "$body")"
  emit "Message $who: $body. Send it?" true "$token"
}

plan_claude() {
  local repo_name="$1" task="$2" dir token

  if ! dir="$(resolve_repo "$repo_name")"; then
    emit "I couldn't find a repo called $repo_name under your project folders." false ""
    return 0
  fi
  if ! have_claude; then
    emit "Claude Code isn't installed on this Mac, so I can't hand that off." false ""
    return 0
  fi

  token="$(new_token)"
  save_plan "$token" "INTENT=claude" "DIR=$dir" "TASK=$task" "REPO=$(basename "$dir")"
  emit "Send Claude into $(basename "$dir") to $task. Go ahead?" true "$token"
}

plan_mail_reply() {
  local body="$1" token candidates count drafted=0 failed=0 line id name address subject
  body="$(emoji_expand "$body")"

  candidates="$(mail_awaiting_reply)"
  count="$(printf '%s' "$candidates" | grep -c . )"
  if [ "$count" -eq 0 ]; then
    emit "Nothing in your inbox is waiting on a reply." false ""
    return 0
  fi

  token="$(new_token)"
  : > "$(plan_file "$token")"
  printf '%s\n' "INTENT=mail_reply" >> "$(plan_file "$token")"

  # Drafts are written now, so you can read or delete them before the send.
  while IFS="$(printf '\t')" read -r id name address subject; do
    [ -z "$address" ] && continue
    if mail_draft_reply "$id" "$body"; then
      drafted=$((drafted + 1))
      printf 'DRAFT\t%s\t%s\t%s\n' "$subject" "$address" "$name" >> "$(plan_file "$token")"
    else
      failed=$((failed + 1))
    fi
  done <<EOT
$candidates
EOT

  if [ "$drafted" -eq 0 ]; then
    rm -f "$(plan_file "$token")"
    emit "I found $(num_word "$count") waiting on a reply, but couldn't draft any of them." false ""
    return 0
  fi

  local extra=""
  [ "$failed" -gt 0 ] && extra=" $(num_word "$failed") couldn't be drafted."
  emit "$(num_word "$drafted") $(_plural "$drafted" reply replies) drafted and waiting in Mail.$extra Send $(_plural "$drafted" it them)?" true "$token"
}

plan_call() {
  local who="$1" kind="$2" handle token label

  if ! handle="$(contact_handle "$who")"; then
    emit "I couldn't find $who in your contacts, so I won't guess at a number." false ""
    return 0
  fi

  if system_needs_confirm "$kind"; then
    token="$(new_token)"
    save_plan "$token" "INTENT=system" "ACTION=$kind" "ARG=$handle"
    emit "$(system_describe "$kind" "$who")" true "$token"
  else
    emit "$(system_run "$kind" "$handle") $who." false ""
  fi
}

# The social half of talking to something. "Thanks" ends the conversation,
# which is how you stop without saying stop.
plan_social() {
  case "$1" in
    thanks)     emit "$ORBIT_SIGNOFF" false "" true ;;
    hello)      emit "$(_greeting_word), $WELCOME_NAME. What do you need?" false "" ;;
    howareyou)  emit "Running fine. What can I do?" false "" ;;
    goodnight)  emit "Good night, $WELCOME_NAME." false "" true ;;
    nevermind)  emit "No problem." false "" true ;;
    praise)     emit "Any time." false "" ;;
    chat)       emit "Sure. What's on your mind?" false "" ;;
    present)    emit "I'm here." false "" ;;
    *)          emit "I'm here." false "" ;;
  esac
}

plan_ask() {
  local question="$1" answer
  answer="$(ask_claude "$question")" || {
    emit "I can't answer that without Claude Code installed." false ""
    return 0
  }
  emit "$(tone_shape "$ORBIT_TONE" "$answer")" false ""
}

plan_screen() {
  local answer
  answer="$(ask_about_screen "$1")" || {
    emit "I couldn't read the screen just then." false ""
    return 0
  }
  emit "$answer" false ""
}

# A macro is a phrase standing in for several commands. Each step is an
# ordinary command, so a macro can do anything you could say out loud - and
# if any step needs confirming, the whole macro is confirmed once.
plan_macro() {
  local phrase="$1" steps token needs_confirm=0 step parsed intent
  steps="$(macro_steps "$phrase")" || return 1
  [ -z "$steps" ] && return 1

  token="$(new_token)"
  : > "$(plan_file "$token")"
  printf 'INTENT=macro\n' >> "$(plan_file "$token")"
  printf 'PHRASE=%s\n' "$phrase" >> "$(plan_file "$token")"

  while IFS= read -r step; do
    [ -z "$step" ] && continue
    printf 'STEP\t%s\n' "$step" >> "$(plan_file "$token")"
    parsed="$(parse_intent "$step")"
    intent="$(printf '%s' "$parsed" | cut -f1)"
    if [ "$intent" = "system" ]; then
      system_needs_confirm "$(printf '%s' "$parsed" | cut -f2)" && needs_confirm=1
    else
      needs_confirm=1   # anything that isn't a plain Mac control
    fi
  done <<EOT
$steps
EOT

  local count
  count="$(printf '%s\n' "$steps" | grep -c .)"
  if [ "$needs_confirm" = "1" ]; then
    emit "$phrase: $(num_word "$count") $(_plural "$count" step steps). Go ahead?" true "$token"
  else
    rm -f "$(plan_file "$token")"
    emit "$(run_macro_steps "$steps")" false ""
  fi
}

# Runs each step and reports what happened, briefly.
run_macro_steps() {
  local steps="$1" step parsed intent done_count=0
  while IFS= read -r step; do
    [ -z "$step" ] && continue
    parsed="$(parse_intent "$step")"
    intent="$(printf '%s' "$parsed" | cut -f1)"
    case "$intent" in
      system) system_run "$(printf '%s' "$parsed" | cut -f2)" "$(printf '%s' "$parsed" | cut -f3)" >/dev/null ;;
      *)      : ;;
    esac
    done_count=$((done_count + 1))
  done <<EOT
$steps
EOT
  printf 'Done. %s %s.' "$(num_word "$done_count")" "$(_plural "$done_count" step steps)"
}

plan_system() {
  local action="$1" arg="${2:-}" summary="${3:-}" token

  if system_needs_confirm "$action"; then
    token="$(new_token)"
    save_plan "$token" "INTENT=system" "ACTION=$action" "ARG=$arg"
    emit "$(system_describe "$action" "${summary:-$arg}")" true "$token"
    return 0
  fi

  # Reversible things just happen - confirming "volume up" out loud is
  # slower than pressing the key would have been.
  emit "$(system_run "$action" "$arg")" false ""
}

# Read-only answers happen immediately; there's nothing to confirm.
plan_readback() {
  local what="$1" text=""
  case "$what" in
    briefing)
      "$ROOT/bin/daily-welcome" --preview --present notification >/dev/null 2>&1 &
      emit "Here's your briefing." false ""
      return 0
      ;;
    messages)
      text="$(_speak_section "$(src_messages)" "unread message" "unread messages" "Nothing unread in Messages.")"
      ;;
    mail)
      # "recent" and "summarise" are asking about the newest mail, not the
      # unread pile - answering the wrong one of those looks like a lie.
      case "$(printf '%s' "${ORBIT_TRANSCRIPT:-}" | tr '[:upper:]' '[:lower:]')" in
        *recent*|*summar*|*"last five"*|*latest*)
          text="$(_speak_section "$(src_mail_recent 5)" "recent email" "recent emails" "There is nothing in your inbox.")" ;;
        *)
          text="$(_speak_section "$(src_mail)" "unread email" "unread emails" "Your inbox is clear.")" ;;
      esac
      ;;
    calendar)
      text="$(_speak_section "$(src_calendar)" "event today" "events today" "Nothing on the calendar today.")"
      ;;
    reminders)
      text="$(_speak_section "$(src_reminders)" "reminder due today" "reminders due today" "No reminders due today.")"
      ;;
    claude)
      text="$(_speak_section "$(src_claude)" "update from Claude" "updates from Claude" "Claude has nothing new for you.")"
      ;;
  esac
  emit "$text" false ""
}

# records, singular, plural, empty-case -> a spoken sentence plus the top items
_speak_section() {
  local records="$1" one="$2" many="$3" empty="$4"
  local n line out note
  n="$(count_records "$records")"

  if [ "$n" -eq 0 ]; then
    # A source that couldn't answer leaves a note. Reporting "your inbox is
    # clear" when Mail actually refused the question is worse than useless:
    # it is a confident wrong answer.
    note="$(printf '%s\n' "$records" | awk -F'\t' '$1 == "#note" { print $2; exit }')"
    if [ -n "$note" ]; then printf '%s' "$note"; else printf '%s' "$empty"; fi
    return 0
  fi

  out="$(num_word "$n") $(_plural "$n" "$one" "$many")."
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    out="$out $line"
  done <<EOT
$(_spoken_items "$records" "$ORBIT_READBACK_ITEMS")
EOT
  printf '%s' "$out" | capitalize_sentences
}

# --- running ---------------------------------------------------------------

run_plan() {
  local token="$1" file
  file="$(plan_file "$token")"
  if [ ! -f "$file" ]; then
    emit "That request has expired. Say it again." false ""
    return 0
  fi

  local INTENT="" HANDLE="" WHO="" BODY="" DIR="" TASK="" REPO="" ACTION="" ARG=""
  while IFS= read -r line; do
    case "$line" in
      INTENT=*) INTENT="${line#INTENT=}" ;;
      HANDLE=*) HANDLE="${line#HANDLE=}" ;;
      WHO=*)    WHO="${line#WHO=}" ;;
      BODY=*)   BODY="${line#BODY=}" ;;
      DIR=*)    DIR="${line#DIR=}" ;;
      TASK=*)   TASK="${line#TASK=}" ;;
      REPO=*)   REPO="${line#REPO=}" ;;
      ACTION=*) ACTION="${line#ACTION=}" ;;
      ARG=*)    ARG="${line#ARG=}" ;;
    esac
  done < "$file"

  case "$INTENT" in
    message)
      if messages_send "$HANDLE" "$BODY"; then
        rm -f "$file"
        emit "Sent to $WHO." false ""
      else
        emit "Messages wouldn't send that. It may not be an iMessage address." false ""
      fi
      ;;
    claude)
      claude_dispatch "$DIR" "$TASK" >/dev/null
      rm -f "$file"
      emit "Claude is on it. I'll tell you what happened in your next briefing." false ""
      ;;
    mail_reply)
      local sent=0 missing=0 result subject address
      while IFS="$(printf '\t')" read -r tag subject address _; do
        [ "$tag" = "DRAFT" ] || continue
        result="$(mail_send_draft "$subject" "$address")"
        if [ "$result" = "sent" ]; then sent=$((sent + 1)); else missing=$((missing + 1)); fi
      done < "$file"
      rm -f "$file"
      if [ "$missing" -gt 0 ]; then
        emit "Sent $(num_word "$sent"). $(num_word "$missing") were gone from Drafts, so I left those alone." false ""
      else
        emit "Sent $(num_word "$sent") $(_plural "$sent" reply replies)." false ""
      fi
      ;;
    macro)
      local steps
      steps="$(awk -F'\t' '$1 == "STEP" { print $2 }' "$file")"
      rm -f "$file"
      emit "$(run_macro_steps "$steps")" false ""
      ;;
    system)
      rm -f "$file"
      emit "$(system_run "$ACTION" "$ARG")" false ""
      ;;
    *)
      emit "I've lost track of that one. Say it again." false ""
      ;;
  esac
}

# --- entry point -----------------------------------------------------------

case "${1:-}" in
  plan)
    shift
    IN_CHAT=0
    if [ "${1:-}" = "--chat" ]; then IN_CHAT=1; shift; fi
    transcript="${1:-}"
    [ -z "$transcript" ] && { emit "I didn't catch that." false ""; exit 0; }
    prune_plans

    # Follow-ups get filled in from what was just said, then the tone of
    # the request sets how the answer is delivered.
    transcript="$(context_expand "$transcript")"
    ORBIT_TONE="$(tone_of "$transcript")"
    export ORBIT_TRANSCRIPT="$transcript"
    tone_apply "$ORBIT_TONE"

    plan_started="$(date '+%s')"
    parsed="$(parse_intent "$transcript")"
    intent="$(printf '%s' "$parsed" | cut -f1)"
    arg1="$(printf '%s' "$parsed" | cut -f2)"
    arg2="$(printf '%s' "$parsed" | cut -f3)"
    arg3="$(printf '%s' "$parsed" | cut -f4)"

    case "$intent" in
      macro)      plan_macro "$arg1" || emit "That macro has no steps." false "" ;;
      chat)
        # The classifier already wrote the answer, so this costs nothing
        # extra - one request understood the sentence and replied to it.
        memory_log_turn "$transcript" "$arg1"
        # Anything durable it noticed goes to the facts file, written by
        # the same request that answered - remembering costs nothing extra.
        [ -n "$arg2" ] && memory_add_fact "$arg2"
        emit "$(tone_shape "$ORBIT_TONE" "$arg1")" false "" ;;
      social)     plan_social "$arg1" ;;
      ask)        plan_ask "$arg1" ;;
      screen)     plan_screen "$arg1" ;;
      message)    plan_message "$arg1" "$arg2" ;;
      claude)     plan_claude "$arg1" "$arg2" ;;
      mail_reply) plan_mail_reply "$arg1" ;;
      call)       plan_call "$arg1" "$arg2" ;;
      system)     plan_system "$arg1" "$arg2" "$arg3" ;;
      readback)   plan_readback "$arg1" ;;
      *)
        # Not a command, so talk. An assistant that only answers the
        # sentences it was written for is a parser with a microphone.
        #
        # Two models, then a plain answer: it always says something, and it
        # never pretends not to have heard.
        if reply="$(openai_chat "$transcript")"; then
          emit "$(tone_shape "$ORBIT_TONE" "$reply")" false ""
        elif reply="$(chat_claude "$transcript")"; then
          emit "$(tone_shape "$ORBIT_TONE" "$reply")" false ""
        elif [ "$IN_CHAT" = "1" ] && [ "$(printf '%s' "$transcript" | wc -w)" -lt 2 ]; then
          # Mid-conversation the microphone is open to the whole room. A
          # single stray word is the room, not you.
          emit "" false ""
        else
          emit "I heard you, but I have no model to answer with. Add a key with daily-welcome, set openai key." false ""
        fi ;;
    esac

    # A record of what was heard and what was made of it. Without this,
    # "it isn't replying correctly" is a guess; with it, it is a diff.
    {
      printf '%s\t%ss\t%s\t%s\n' \
        "$(date '+%H:%M:%S')" "$(( $(date '+%s') - plan_started ))" \
        "$intent" "$(printf '%s' "$transcript" | cut -c1-70)"
    } >> "$WELCOME_STATE_DIR/turns.log" 2>/dev/null
    tail -n 60 "$WELCOME_STATE_DIR/turns.log" > "$WELCOME_STATE_DIR/turns.tmp" 2>/dev/null &&
      mv "$WELCOME_STATE_DIR/turns.tmp" "$WELCOME_STATE_DIR/turns.log"
    ;;
  run)
    shift
    run_plan "${1:-}"
    ;;
  cancel)
    shift
    rm -f "$(plan_file "${1:-none}")"
    emit "Cancelled." false ""
    ;;
  say)
    shift
    speak_async "${1:-}"
    [ -n "${WELCOME_SPEAK_PID:-}" ] && wait "$WELCOME_SPEAK_PID" 2>/dev/null
    ;;
  hush)
    hush
    ;;
  listen)
    shift
    STATUS_FILE="$WELCOME_STATE_DIR/listener-status"
    LABEL="${DAILY_WELCOME_LABEL:-com.arjun.dailywelcome}"
    CFG="${WELCOME_CONFIG:-$HOME/.config/daily-welcome/config.sh}"

    set_listen() {
      mkdir -p "$(dirname "$CFG")"; touch "$CFG"
      grep -v '^ORBIT_LISTEN=' "$CFG" > "$CFG.tmp" 2>/dev/null || : > "$CFG.tmp"
      { cat "$CFG.tmp"; printf 'ORBIT_LISTEN=%s\n' "$1"; } > "$CFG"
      rm -f "$CFG.tmp"
      # The app reads this at launch, so it has to be restarted to notice.
      launchctl kickstart -k "gui/$(id -u)/$LABEL" >/dev/null 2>&1
    }

    case "${1:-status}" in
      on)
        rm -f "$WELCOME_STATE_DIR/paused"
        set_listen 1
        echo "Listening turned on and the app restarted."
        echo "Give it a couple of seconds, then say \"$ORBIT_WAKE_WORD\"."
        ;;
      off)
        set_listen 0
        echo "Listening turned off. The microphone stays shut until you turn it back on."
        ;;
      pause)
        mkdir -p "$WELCOME_STATE_DIR"; : > "$WELCOME_STATE_DIR/paused"
        echo "Microphone closed. It stays that way until you say otherwise:"
        echo "  Option-Space, the menu bar item, or: orbit listen resume"
        ;;
      resume)
        rm -f "$WELCOME_STATE_DIR/paused"
        echo "Listening again."
        ;;
      restart)
        rm -f "$WELCOME_STATE_DIR/paused"
        launchctl kickstart -k "gui/$(id -u)/$LABEL" >/dev/null 2>&1
        echo "Restarted. The ears come back a second or two after the app does."
        ;;
      heard)
        if [ -f "$WELCOME_STATE_DIR/heard.log" ]; then
          echo "The last things it heard while waiting for the wake word:"
          sed 's/^/  /' "$WELCOME_STATE_DIR/heard.log"
          echo
          echo "If your wake word is in there as something else, add it:"
          echo "  orbit listen alias \"<what it hears>\""
        else
          echo "Nothing logged yet. Say something near the Mac and try again."
        fi
        ;;
      wake)
        shift
        if [ -z "${1:-}" ]; then echo "orbit listen wake \"hey computer\"" >&2; exit 2; fi
        mkdir -p "$(dirname "$CFG")"; touch "$CFG"
        grep -v '^ORBIT_WAKE_WORD=' "$CFG" > "$CFG.tmp" 2>/dev/null || : > "$CFG.tmp"
        { cat "$CFG.tmp"; printf 'ORBIT_WAKE_WORD="%s"\n' "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"; } > "$CFG"
        rm -f "$CFG.tmp"
        launchctl kickstart -k "gui/$(id -u)/$LABEL" >/dev/null 2>&1
        echo "Wake word set to \"$1\". Give the app a couple of seconds."
        echo "Ordinary words work far better than invented ones."
        ;;
      alias)
        shift
        if [ -z "${1:-}" ]; then echo "orbit listen alias \"what it hears\"" >&2; exit 2; fi
        mkdir -p "$(dirname "$CFG")"; touch "$CFG"
        existing="$(grep '^ORBIT_WAKE_ALIASES=' "$CFG" 2>/dev/null | tail -1 | sed -E 's/^ORBIT_WAKE_ALIASES="?//; s/"$//')"
        [ -z "$existing" ] && existing="$ORBIT_WAKE_ALIASES"
        grep -v '^ORBIT_WAKE_ALIASES=' "$CFG" > "$CFG.tmp" 2>/dev/null || : > "$CFG.tmp"
        { cat "$CFG.tmp"; printf 'ORBIT_WAKE_ALIASES="%s|%s"\n' "$existing" "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"; } > "$CFG"
        rm -f "$CFG.tmp"
        launchctl kickstart -k "gui/$(id -u)/$LABEL" >/dev/null 2>&1
        echo "\"$1\" now counts as the wake word too."
        ;;
      status|*)
        if [ -s "$WELCOME_STATE_DIR/on-call" ]; then
          echo "Ears:     ON HOLD - $(cat "$WELCOME_STATE_DIR/on-call") is using the microphone"
          echo "          Listening comes back by itself when the call ends."
        fi
        # Paused reads as "not listening" from the outside, so say which.
        if [ -f "$WELCOME_STATE_DIR/paused" ]; then
          echo "Ears:     PAUSED - you asked it to stop listening"
          echo "          orbit listen resume, Option-Space, or say \"wake up\""
        fi
        APP_BIN="$HOME/Applications/DailyWelcome.app/Contents/MacOS/DailyWelcome"
        if pgrep -f "DailyWelcome.app/Contents/MacOS/DailyWelcome" >/dev/null 2>&1; then
          echo "App:      running"
          # A rebuilt app that was never restarted explains a fix that
          # "did not work": the running process is the old one.
          if [ -x "$APP_BIN" ]; then
            newest_source="$(ls -t "$ROOT"/menubar/*.swift 2>/dev/null | head -1)"
            if [ -n "$newest_source" ] && [ "$newest_source" -nt "$APP_BIN" ]; then
              echo "Build:    STALE - sources are newer than the app (./install.sh)"
            else
              echo "Build:    current"
            fi
          fi
        else
          echo "App:      NOT running   (orbit listen restart)"
        fi
        if [ -f "$STATUS_FILE" ]; then
          awk -F'\t' '
            $1 == "state"   { printf "State:    %s\n", $2 }
            $1 == "detail"  { printf "Detail:   %s\n", $2 }
            $1 == "updated" { printf "Updated:  %s\n", $2 }
            $1 == "heard"   { printf "Heard:    \"%s\"\n", $2 }
          ' "$STATUS_FILE"
          # A status that hasn't moved in a while means the ears are stuck,
          # which looks identical to "not listening" from the outside.
          if [ -z "$(find "$STATUS_FILE" -mmin -10 2>/dev/null)" ]; then
            echo
            echo "That status is over ten minutes old, so it's probably stuck."
            echo "  orbit listen restart"
          fi
        else
          echo "State:    never started"
          echo "  orbit listen on"
        fi
        ;;
    esac
    ;;
  watch)
    # One announcement or nothing. Called on a timer by the menu bar app.
    line="$(watch_once)" || exit 0
    [ -z "$line" ] && exit 0
    speak_async "$line"
    [ -n "${WELCOME_SPEAK_PID:-}" ] && wait "$WELCOME_SPEAK_PID" 2>/dev/null
    printf '%s\n' "$line"
    ;;
  memory)
    shift
    case "${1:-show}" in
      show)
        facts="$(memory_facts)"
        if [ -n "$facts" ]; then
          echo "What it remembers about you:"
          printf '%s\n' "$facts" | awk -F'\t' '{ printf "  %s  %s\n", $1, $2 }'
        else
          echo "It hasn't noted anything durable yet."
        fi
        echo
        echo "Recent conversation:"
        memory_recent | awk -F'\t' '{ printf "  %-9s %s\n", $1, substr($2, 1, 68) }' | tail -12
        ;;
      forget)
        shift
        [ -z "${1:-}" ] && { echo 'orbit memory forget "<words>"' >&2; exit 2; }
        memory_forget "$1"; echo "Forgotten anything mentioning \"$1\"." ;;
      clear)  memory_clear; echo "Memory cleared - facts and conversation both." ;;
      add)
        shift
        [ -z "${1:-}" ] && { echo 'orbit memory add "<a fact>"' >&2; exit 2; }
        memory_add_fact "$1"; echo "Noted." ;;
      *) echo 'orbit memory [show|add "..."|forget "..."|clear]' >&2; exit 2 ;;
    esac
    ;;
  log)
    # What it heard, how it read it, and how long each turn took.
    if [ -f "$WELCOME_STATE_DIR/turns.log" ]; then
      printf 'time      took  intent      what you said\n'
      awk -F'\t' '{ printf "%-9s %-5s %-11s %s\n", $1, $2, $3, $4 }' \
        "$WELCOME_STATE_DIR/turns.log" | tail -n "${2:-20}"
      printf '\nintent "chat" is conversation; "none" is nothing understood.\n'
    else
      echo "Nothing yet. Say something to it first."
    fi

    # A turn that produced no answer at all leaves its reason here rather
    # than in /dev/null, which is where it used to go.
    if [ -s "$WELCOME_STATE_DIR/orbit-errors.log" ]; then
      printf '\nErrors from the last few turns:\n'
      tail -n 20 "$WELCOME_STATE_DIR/orbit-errors.log" | sed 's/^/  /'
    fi
    ;;
  selftest)
    # Every upgrade, checked in the environment it actually runs in.
    pass() { printf '  \033[32mok\033[0m   %s\n' "$1"; }
    fail() { printf '  \033[31mno\033[0m   %s\n' "$1"; printf '       %s\n' "$2"; }

    printf '\nOrbit self-test\n\n'

    if [ "$ORBIT_PAUSE_ON_CALL" != "1" ]; then
      pass "Call detection off (ORBIT_PAUSE_ON_CALL=0)"
    elif on_a_call; then
      pass "Call detection working - $(on_a_call_app) has the microphone now"
    else
      pass "Call detection on - listening pauses while another app records"
    fi

    if claude_bin >/dev/null 2>&1; then pass "Claude Code found at $(claude_bin)"
    else fail "Claude Code not found" "Questions, screen reading and repo jobs all need it"; fi

    if [ -n "$(ask_claude 'say the word ready and nothing else' 2>/dev/null)" ]; then
      pass "Questions answered"
    else fail "Questions not answered" "claude -p returned nothing within ${ORBIT_ASK_TIMEOUT}s"; fi

    if eleven_available; then
      if [ -n "$(speak_to_file 'Self test.' 2>/dev/null)" ]; then pass "Voice renders"
      else fail "Voice does not render" "$(cat "$WELCOME_STATE_DIR/last-voice-error" 2>/dev/null | head -c 160)"; fi
    else fail "ElevenLabs not available" "daily-welcome --check-key"; fi

    n="$(count_records "$(src_mail)")"
    note="$(printf '%s\n' "$(src_mail)" | awk -F'\t' '$1 == "#note" { print $2; exit }')"
    if [ -n "$note" ]; then fail "Mail" "$note"
    else pass "Mail readable ($n unread)"; fi

    n="$(count_records "$(src_reminders)")"
    note="$(printf '%s\n' "$(src_reminders)" | awk -F'\t' '$1 == "#note" { print $2; exit }')"
    if [ -n "$note" ]; then fail "Reminders" "$note"
    else pass "Reminders readable ($n due)"; fi

    if [ -f "$ORBIT_MACROS_FILE" ] && [ -n "$(macros_list)" ]; then
      pass "Macros defined: $(macros_list | cut -f1 | tr '\n' ' ')"
    else fail "No macros" "Add some to $ORBIT_MACROS_FILE"; fi

    if [ -f "$WELCOME_STATE_DIR/listener-status" ]; then
      pass "Listener state: $(awk -F'\t' '$1 == "state" { print $2 }' "$WELCOME_STATE_DIR/listener-status")"
    else fail "Listener has never run" "orbit listen on"; fi

    printf '\n'
    ;;
  console)
    shift
    if ! have_cmd python3; then
      echo "orbit: the console needs python3 (xcode-select --install)." >&2
      exit 1
    fi
    CFG="${WELCOME_CONFIG:-$HOME/.config/daily-welcome/config.sh}"
    case "${1:-}" in
      --allow)
        # Which deployed site may drive this Mac.
        shift
        [ -z "${1:-}" ] && { echo 'orbit console --allow https://your.vercel.app' >&2; exit 2; }
        mkdir -p "$(dirname "$CFG")"; touch "$CFG"
        grep -v '^ORBIT_CONSOLE_ORIGINS=' "$CFG" > "$CFG.tmp" 2>/dev/null || : > "$CFG.tmp"
        { cat "$CFG.tmp"; printf 'ORBIT_CONSOLE_ORIGINS="%s"\n' "$1"; } > "$CFG"
        rm -f "$CFG.tmp"
        echo "$1 may now connect. Start the bridge with: orbit console --bridge"
        exit 0 ;;
      --token)
        python3 -c "import sys; sys.path.insert(0, '$ROOT/web'); import server; print(server.token())"
        exit 0 ;;
      --bridge)
        shift ;;   # same server, just not opening a browser
    esac
    export ORBIT_CONSOLE_ORIGINS
    exec python3 "$ROOT/web/server.py" "$@"
    ;;
  timer-fire)
    # Runs detached: sleep, then say so. Only ever started by nohup.
    shift
    minutes="${1:-5}"
    sleep $((minutes * 60))
    speak_async "Your $(num_word "$minutes") minute timer is up."
    [ -n "${WELCOME_SPEAK_PID:-}" ] && wait "$WELCOME_SPEAK_PID" 2>/dev/null
    ;;
  warm)
    # Synthesis is the slow part of a reply, and the same handful of lines
    # come up constantly. Rendering them once, up front, means the common
    # cases play from disk instead of waiting on the network.
    if ! eleven_available; then
      echo "orbit: no ElevenLabs key, nothing to warm." >&2
      exit 0
    fi
    warmed=0
    for line in \
      "$ORBIT_GREETING" \
      "Done." "Cancelled." "On it." "Sent." "Calling." \
      "Muted." "Sound back on." "Volume up." "Volume down." \
      "Saved to your desktop." "Locked." "Noted." \
      "Added to your reminders." "Copied." "Next." "Back one." \
      "I didn't catch that. Try: message Mom saying I'm running late." \
      "That request has expired. Say it again." \
      "Claude is on it. I'll tell you what happened in your next briefing."
    do
      [ -z "$line" ] && continue
      if eleven_cache_line "$line"; then
        warmed=$((warmed + 1))
        printf '.'
      else
        printf 'x'
      fi
    done
    printf '\n%d lines ready to play instantly.\n' "$warmed"
    ;;
  greeting)
    # The wake word on its own: acknowledge, then keep listening.
    emit "$ORBIT_GREETING" false ""
    ;;
  config)
    # One source of truth for settings: the menu bar app asks for these
    # rather than keeping its own copy that drifts from your config file.
    shift
    case "${1:-}" in
      wake_word) printf '%s\n' "$ORBIT_WAKE_WORD" ;;
      listen)    printf '%s\n' "$ORBIT_LISTEN" ;;
      followup)  printf '%s\n' "$ORBIT_FOLLOWUP_SECONDS" ;;
      aliases)   printf '%s\n' "$ORBIT_WAKE_ALIASES" ;;
      conversation) printf '%s\n' "$ORBIT_CONVERSATION" ;;
      conversation_seconds) printf '%s\n' "$ORBIT_CONVERSATION_SECONDS" ;;
      wake_threshold) printf '%s\n' "$ORBIT_WAKE_THRESHOLD" ;;
      ondevice)  printf '%s\n' "$ORBIT_ONDEVICE" ;;
      hotkey)    printf '%s\n' "$ORBIT_HOTKEY" ;;
      pause_on_call) printf '%s\n' "$ORBIT_PAUSE_ON_CALL" ;;
      call_ignore)   printf '%s\n' "$ORBIT_CALL_IGNORE" ;;
      *)         printf 'orbit config: wake_word | listen | followup | aliases | hotkey |\n' >&2
                 printf '             conversation | ondevice | pause_on_call | call_ignore\n' >&2
                 exit 2 ;;
    esac
    ;;
  debug)
    # One command, one thing to paste back. Everything worth knowing when
    # it "just isn't responding", in the order it would go wrong.
    printf '\n=== orbit debug ===\n'
    printf 'when:     %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')"
    printf 'macOS:    %s (%s)\n' "$(sw_vers -productVersion 2>/dev/null)" "$(uname -m)"
    printf 'repo:     %s\n' "$ROOT"
    printf 'commit:   %s\n' "$(git -C "$ROOT" log --oneline -1 2>/dev/null || echo 'not a git checkout')"

    APP_BIN="$HOME/Applications/DailyWelcome.app/Contents/MacOS/DailyWelcome"
    newest="$(ls -t "$ROOT"/menubar/*.swift 2>/dev/null | head -1)"
    if [ ! -x "$APP_BIN" ]; then
      printf 'build:    NO APP BUILT - run ./install.sh\n'
    elif [ -n "$newest" ] && [ "$newest" -nt "$APP_BIN" ]; then
      printf 'build:    STALE - the running app predates your last git pull\n'
      printf '          >>> run ./macos-daily-welcome/install.sh <<<\n'
    else
      printf 'build:    current\n'
    fi

    printf '\n--- listener ---\n'
    "$0" listen status 2>&1 | sed 's/^/  /'

    printf '\n--- keys ---\n'
    if eleven_api_key >/dev/null 2>&1; then printf '  ElevenLabs: found\n'
    else printf '  ElevenLabs: MISSING   (daily-welcome --set-key)\n'; fi
    if openai_api_key >/dev/null 2>&1; then printf '  OpenAI:     found\n'
    else printf '  OpenAI:     missing   (daily-welcome --set-openai-key)\n'; fi
    if claude_bin >/dev/null 2>&1; then printf '  Claude:     %s\n' "$(claude_bin)"
    else printf '  Claude:     not on PATH\n'; fi
    printf '  NLU mode:   %s\n' "$ORBIT_NLU"

    printf '\n--- a turn, end to end ---\n'
    for probe in "what time is it" "set a timer for ten minutes" "brief me"; do
      start="$(date '+%s')"
      line="$("$0" plan "$probe" 2>&1 | tail -1)"
      took=$(( $(date '+%s') - start ))
      printf '  %-30s %2ds  %s\n' "\"$probe\"" "$took" "$(printf '%s' "$line" | cut -c1-70)"
    done

    printf '\n--- last turns ---\n'
    "$0" log 12 2>&1 | sed 's/^/  /'
    printf '\n=== end ===\n\n'
    ;;
  examples)
    intent_examples
    ;;
  -h|--help|"")
    usage
    ;;
  *)
    printf 'orbit: unknown command %s\n\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac
